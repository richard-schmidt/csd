import DDD.Schema
import Mathlib.CategoryTheory.Category.Cat
import Mathlib.CategoryTheory.PathCategory.Basic
import Mathlib.CategoryTheory.Quotient

/-!
# The category a schema presents

The shallow embedding of a schema `S`:

- `S.Obj`: the declared entity types and all value types;
- the quiver on `S.Obj` whose arrows `a ⟶ b` are the names of the generators
  from `a` to `b`;
- `S.rel`: two paths are related when their names are the two sides of an
  equation;
- `S.cat : Cat`: the free category on the quiver (`Paths`), quotiented by the
  congruence generated by `S.rel` (`Quotient`).

A deep path, a source and a list of names, and a path of the quiver correspond
through `Schema.names`: a path is determined by its source and its names
(`names_injective`), it splits along every split of its names (`exists_split`),
and in a well-formed schema every list of names with a target is the list of
names of a path (`exists_path`).

`S.PathEq a l l'` says that the paths named `l` and `l'` out of `a` exist, are
parallel and present the same morphism of `S.cat`. Every equation of a
well-formed schema holds in this sense (`pathEq_of_mem_eqns`).
-/

namespace DDD

namespace Schema

open CategoryTheory

variable (S : Schema)

/-- `o` is an object of the schema: a declared entity type, or a value type. -/
def IsOb : Ob → Prop
  | .entity e => e ∈ S.entities
  | .value _ => True

instance : DecidablePred S.IsOb
  | .entity e => inferInstanceAs (Decidable (e ∈ S.entities))
  | .value _ => inferInstanceAs (Decidable True)

/-- The objects of the schema category. -/
def Obj : Type := { o : Ob // S.IsOb o }

instance : DecidableEq S.Obj := inferInstanceAs (DecidableEq { o : Ob // S.IsOb o })

/-- An arrow `a ⟶ b` is the name of a generator from `a` to `b`. -/
instance : Quiver S.Obj where
  Hom a b := { n : String // S.step? a.1 n = some b.1 }

variable {S}

/-- The generator names along a path. -/
def names {a : S.Obj} : ∀ {b : S.Obj}, Quiver.Path a b → List String
  | _, .nil => []
  | _, .cons p e => names p ++ [e.1]

@[simp] theorem names_nil {a : S.Obj} : names (Quiver.Path.nil : Quiver.Path a a) = [] := rfl

@[simp] theorem names_cons {a b c : S.Obj} (p : Quiver.Path a b) (e : b ⟶ c) :
    names (p.cons e) = names p ++ [e.1] := rfl

@[simp] theorem names_comp {a b c : S.Obj} (p : Quiver.Path a b) (q : Quiver.Path b c) :
    names (p.comp q) = names p ++ names q := by
  induction q with
  | nil => simp
  | cons q e ih => simp [ih]

@[simp] theorem names_toPath {a b : S.Obj} (e : a ⟶ b) : names e.toPath = [e.1] := rfl

/-- The names of a path lead from its source to its target. -/
theorem tgt?_names {a b : S.Obj} (p : Quiver.Path a b) : S.tgt? a.1 (names p) = some b.1 := by
  induction p with
  | nil => rfl
  | cons p e ih => simp [tgt?_append, ih, e.2]

/-- A path is determined by its source and its names. -/
theorem names_injective {a : S.Obj} :
    ∀ {b : S.Obj} (p q : Quiver.Path a b), names p = names q → p = q
  | _, .nil, .nil, _ => rfl
  | _, .nil, .cons _ _, h => by simp at h
  | _, .cons _ _, .nil, h => by simp at h
  | _, .cons (b := x) p e, .cons (b := y) q e', h => by
    obtain ⟨h₁, h₂⟩ := List.append_inj' h rfl
    have hxy : x = y := Subtype.ext <| Option.some.inj <|
      (tgt?_names p).symm.trans (h₁ ▸ tgt?_names q)
    subst hxy
    obtain rfl := names_injective p q h₁
    obtain rfl : e = e' := Subtype.ext (List.singleton_inj.mp h₂)
    rfl

/-- A path whose names are `u ++ v` is a path named `u` followed by a path named `v`. -/
theorem exists_split {a : S.Obj} :
    ∀ {b : S.Obj} (p : Quiver.Path a b) (u v : List String), names p = u ++ v →
      ∃ (c : S.Obj) (p₁ : Quiver.Path a c) (p₂ : Quiver.Path c b),
        p = p₁.comp p₂ ∧ names p₁ = u ∧ names p₂ = v
  | _, p, u, v, h => by
    rcases List.eq_nil_or_concat v with rfl | ⟨v', n, rfl⟩
    · exact ⟨_, p, .nil, rfl, by simpa using h, rfl⟩
    · cases p with
      | nil => simp at h
      | cons p e =>
        rw [names_cons, List.concat_eq_append, ← List.append_assoc] at h
        obtain ⟨h₁, h₂⟩ := List.append_inj' h rfl
        obtain ⟨c, p₁, p₂, rfl, hu, hv⟩ := exists_split p u v' h₁
        exact ⟨c, p₁, p₂.cons e, rfl, hu, by simp [hv, List.singleton_inj.mp h₂]⟩

/-- `names` on composites in the path category. -/
@[simp] theorem names_paths_comp {a b c : Paths S.Obj} (p : a ⟶ b) (q : b ⟶ c) :
    names (S := S) (p ≫ q) = names (S := S) p ++ names (S := S) q :=
  names_comp p q

variable (S)

/-- Two paths are related when their names are the two sides of an equation. -/
def rel : HomRel (Paths S.Obj) := fun a _ f g =>
  ∃ q ∈ S.eqns, a.1 = .entity q.src ∧ names f = q.lhs ∧ names g = q.rhs

/-- The category a schema presents. -/
def cat : Cat := Cat.of (CategoryTheory.Quotient S.rel)

/-- The object of `S.cat` for an object of `S`. -/
def obj (a : S.Obj) : S.cat := (Quotient.functor S.rel).obj a

variable {S}

/-- The morphism of `S.cat` a path presents. -/
def mor {a b : S.Obj} (p : Quiver.Path a b) : S.obj a ⟶ S.obj b :=
  (Quotient.functor S.rel).map (X := a) (Y := b) p

@[simp] theorem mor_nil {a : S.Obj} : mor (Quiver.Path.nil : Quiver.Path a a) = 𝟙 (S.obj a) :=
  (CategoryTheory.Quotient.functor S.rel).map_id (X := a)

theorem mor_comp {a b c : S.Obj} (p : Quiver.Path a b) (q : Quiver.Path b c) :
    mor (p.comp q) = mor p ≫ mor q :=
  (Quotient.functor S.rel).map_comp (X := a) (Y := b) (Z := c) p q

/-- Two paths present the same morphism exactly when they are related by the
congruence generated by the equations. -/
theorem mor_eq_iff {a b : S.Obj} (p q : Quiver.Path a b) :
    mor p = mor q ↔ Relation.EqvGen (Quotient.CompClosure S.rel (s := a) (t := b)) p q :=
  Quotient.functor_homRel_eq_compClosure_eqvGen (r := S.rel) (X := a) (Y := b) p q

variable (S)

/-- The paths named `l` and `l'` out of `a` exist, are parallel, and present the
same morphism of `S.cat`. -/
def PathEq (a : S.Obj) (l l' : List String) : Prop :=
  ∃ (b : S.Obj) (p q : Quiver.Path a b), names p = l ∧ names q = l' ∧ mor p = mor q

variable {S}

/-- A generator out of `o` is a reference or an attribute of `S` out of an entity
type. -/
theorem exists_gen_of_step? {o o' : Ob} {n : String} (h : S.step? o n = some o') :
    ∃ e, o = .entity e ∧
      ((∃ r ∈ S.refs, r.src = e ∧ r.name = n) ∨ (∃ a ∈ S.attrs, a.src = e ∧ a.name = n)) := by
  cases o with
  | value => simp [step?] at h
  | entity e =>
    refine ⟨e, rfl, ?_⟩
    simp only [step?] at h
    split at h
    · rename_i r hr
      unfold ref? at hr
      have hp := List.find?_some hr
      simp only [Bool.and_eq_true, beq_iff_eq] at hp
      exact Or.inl ⟨r, List.mem_of_find?_eq_some hr, hp⟩
    · obtain ⟨a, ha, -⟩ := Option.map_eq_some_iff.mp h
      unfold attr? at ha
      have hp := List.find?_some ha
      simp only [Bool.and_eq_true, beq_iff_eq] at hp
      exact Or.inr ⟨a, List.mem_of_find?_eq_some ha, hp⟩

/-- In a well-formed schema, a generator out of a declared object ends at a
declared object. -/
theorem isOb_of_step? (hS : S.WellFormed) {o o' : Ob} {n : String}
    (h : S.step? o n = some o') : S.IsOb o' := by
  cases o with
  | value => simp [step?] at h
  | entity e =>
    simp only [step?] at h
    split at h
    · rename_i r hr
      cases h
      exact hS.ref_tgt r (List.mem_of_find?_eq_some hr)
    · obtain ⟨a, -, rfl⟩ := Option.map_eq_some_iff.mp h
      trivial

/-- In a well-formed schema, every list of names with a target out of an object is
the list of names of a path. -/
theorem exists_path (hS : S.WellFormed) :
    ∀ (a : S.Obj) (l : List String) {o : Ob}, S.tgt? a.1 l = some o →
      ∃ (b : S.Obj) (p : Quiver.Path a b), b.1 = o ∧ names p = l
  | a, [], _, h => ⟨a, .nil, Option.some.inj h, rfl⟩
  | a, n :: ns, _, h => by
    obtain ⟨o', h₁, h₂⟩ := Option.bind_eq_some_iff.mp h
    obtain ⟨b, p, rfl, rfl⟩ := exists_path hS ⟨o', isOb_of_step? hS h₁⟩ ns h₂
    exact ⟨b, (Quiver.Hom.toPath (show a ⟶ ⟨o', _⟩ from ⟨n, h₁⟩)).comp p, rfl, by simp⟩

/-- In a well-formed schema, every equation holds in `S.cat`. -/
theorem pathEq_of_mem_eqns (hS : S.WellFormed) {q : Equation} (hq : q ∈ S.eqns) :
    S.PathEq ⟨.entity q.src, hS.eqn_src q hq⟩ q.lhs q.rhs := by
  obtain ⟨o, hl, hr⟩ := hS.eqn_parallel q hq
  obtain ⟨b, p, rfl, hp⟩ := exists_path hS ⟨.entity q.src, hS.eqn_src q hq⟩ q.lhs hl
  obtain ⟨b', p', hb, hp'⟩ := exists_path hS ⟨.entity q.src, hS.eqn_src q hq⟩ q.rhs hr
  obtain rfl : b = b' := Subtype.ext hb.symm
  exact ⟨b, p, p', hp, hp', CategoryTheory.Quotient.sound _ ⟨q, hq, rfl, hp, hp'⟩⟩

/-- In a well-formed schema, the path named `l` from `a` to `b`, given that `l`
leads from `a` to `b`. -/
def pathOf (hS : S.WellFormed) :
    ∀ (a b : S.Obj) (l : List String), S.tgt? a.1 l = some b.1 → Quiver.Path a b
  | a, b, [], h => (Subtype.ext (Option.some.inj h) : a = b) ▸ Quiver.Path.nil
  | a, b, n :: ns, h =>
    match hs : S.step? a.1 n with
    | none => absurd h (by simp [hs])
    | some o =>
      (Quiver.Hom.toPath (show a ⟶ ⟨o, isOb_of_step? hS hs⟩ from ⟨n, hs⟩)).comp
        (pathOf hS ⟨o, isOb_of_step? hS hs⟩ b ns (by simpa [hs] using h))

@[simp] theorem names_pathOf (hS : S.WellFormed) :
    ∀ (a b : S.Obj) (l : List String) (h : S.tgt? a.1 l = some b.1),
      names (pathOf hS a b l h) = l
  | a, b, [], h => by
    obtain rfl : a = b := Subtype.ext (Option.some.inj h)
    rfl
  | a, b, n :: ns, h => by
    unfold pathOf
    split
    · rename_i hs
      simp [hs] at h
    · simp [names_pathOf]

/-- In a well-formed schema, a generator starts at a declared object. -/
theorem isOb_src_of_step? (hS : S.WellFormed) {o o' : Ob} {n : String}
    (h : S.step? o n = some o') : S.IsOb o := by
  cases o with
  | value => trivial
  | entity e =>
    simp only [step?] at h
    split at h
    · rename_i r hr
      unfold ref? at hr
      have hp := List.find?_some hr
      simp only [Bool.and_eq_true, beq_iff_eq] at hp
      exact hp.1 ▸ hS.ref_src r (List.mem_of_find?_eq_some hr)
    · obtain ⟨a, ha, -⟩ := Option.map_eq_some_iff.mp h
      unfold attr? at ha
      have hp := List.find?_some ha
      simp only [Bool.and_eq_true, beq_iff_eq] at hp
      exact hp.1 ▸ hS.attr_src a (List.mem_of_find?_eq_some ha)

/-- In a well-formed schema, a path from a declared object ends at a declared
object. -/
theorem isOb_of_tgt? (hS : S.WellFormed) :
    ∀ {o x : Ob} {l : List String}, S.IsOb o → S.tgt? o l = some x → S.IsOb x
  | _, _, [], ho, h => Option.some.inj h ▸ ho
  | o, x, n :: ns, _, h => by
    cases hs : S.step? o n with
    | none => simp [hs] at h
    | some o' =>
      simp only [tgt?_cons, hs, Option.bind_some] at h
      exact isOb_of_tgt? hS (isOb_of_step? hS hs) h

/-- Every object of `S.cat` is the object of an object of `S`. -/
theorem obj_surjective (X : S.cat) : ∃ a, S.obj a = X := ⟨X.as, rfl⟩

/-- Every morphism of `S.cat` is presented by a path. -/
theorem mor_surjective {a b : S.Obj} (f : S.obj a ⟶ S.obj b) :
    ∃ p : Quiver.Path a b, mor p = f :=
  (CategoryTheory.Quotient.functor S.rel).map_surjective f

/-- Paths with the same names present the same morphism, up to the equalities of
their endpoints. -/
theorem mor_eq_of_names {a a' b b' : S.Obj} (ha : a = a') (hb : b = b') (p : Quiver.Path a b)
    (p' : Quiver.Path a' b') (h : names p = names p') :
    mor p = eqToHom (congrArg S.obj ha) ≫ mor p' ≫ eqToHom (congrArg S.obj hb).symm := by
  subst ha hb
  obtain rfl := names_injective p p' h
  simp

/-- The path of the generator named `n` from `a` to `b`. -/
abbrev genPath (a b : S.Obj) (n : String) (h : S.step? a.1 n = some b.1) : Quiver.Path a b :=
  Quiver.Hom.toPath (show a ⟶ b from ⟨n, h⟩)

/-- The generator named `n` from `a` to `b`, as a morphism of `S.cat`. -/
abbrev genMor {a b : S.Obj} (n : String) (h : S.step? a.1 n = some b.1) : S.obj a ⟶ S.obj b :=
  mor (S.genPath a b n h)

/-- `mor_eq_of_names` under a functor. -/
theorem map_mor_eq_of_names {X : Type*} [Category X] (F : S.cat ⥤ X) {a a' b b' : S.Obj}
    (ha : a = a') (hb : b = b') (p : Quiver.Path a b) (p' : Quiver.Path a' b')
    (h : names p = names p') :
    F.map (mor p) = eqToHom (by rw [ha]) ≫ F.map (mor p') ≫ eqToHom (by rw [hb]) := by
  subst ha hb
  obtain rfl := names_injective p p' h
  simp

/-- Two functors out of `S.cat` are equal when they agree on objects and on
generators. -/
theorem ext_functor {X : Type*} [Category X] {F G : S.cat ⥤ X}
    (h_obj : ∀ a, F.obj (S.obj a) = G.obj (S.obj a))
    (h_map : ∀ (a b : S.Obj) (e : a ⟶ b), F.map (mor e.toPath) =
      eqToHom (h_obj a) ≫ G.map (mor e.toPath) ≫ eqToHom (h_obj b).symm) : F = G := by
  apply CategoryTheory.Quotient.lift_unique'
  exact Paths.ext_functor (funext h_obj) h_map

/-- Paths whose names satisfy `PathEq` present the same morphism. -/
theorem PathEq.mor_eq {a b : S.Obj} {p q : Quiver.Path a b}
    (h : S.PathEq a (names p) (names q)) : mor p = mor q := by
  obtain ⟨b', p', q', hp, hq, hm⟩ := h
  obtain rfl : b' = b :=
    Subtype.ext (Option.some.inj ((tgt?_names p').symm.trans (hp ▸ tgt?_names p)))
  rwa [names_injective p' p hp, names_injective q' q hq] at hm

end Schema

end DDD
