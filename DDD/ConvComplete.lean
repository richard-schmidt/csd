import DDD.ConvNF

/-!
# Completeness of the normal forms of conversions

For a sound list of value types, paths of conversions that present the same morphism of
`S.vcat L` have the same normal form (`Schema.convEq_complete`), so `TypeList.convEq`
decides path equality of conversions (`Schema.convEq_iff`). `Schema.pathEqV` decides path
equality in `S.vcat L` wherever `Schema.pathEq` decides it in `S`: out of a value type
(`pathEqV_value_iff`), and in free and in acyclic schemas (`pathEqV_iff_of_free`,
`pathEqV_iff_of_acyclic`).

The proof follows the congruence generated by the equations.

- A stack is reduced (`TypeList.Red`) when no step reduces with the stack below it.
  `push` keeps stacks reduced (`push_red`) and takes equivalent stacks to equivalent
  stacks (`push_congr`); stacks are equivalent when their steps are equal or runs of
  tables that compute the same function (`sameStk`).
- On a reduced stack, the two sides of each equation of `Basic` at a plain type give
  equivalent stacks (`pushAll_basic`). A coercion cancels the inverse coercion below it
  and otherwise goes on the stack (`push_down`, `push_up`); `date` and `time` replace a
  `datetime` below them (`push_date_merge`); `string` after a coercion is `string` out
  of its source (`push_string_up`, `push_string_down`); a path of tables is the run of
  tables it computes (`pushAll_tables`).
- At an optional type, the stack is the lift of a stack of plain types (`Tok.lift`) on
  a stack that pushes at optional types do not reach (`Wall`), and pushing commutes with
  the lift (`push_lift`).
- The normal forms of paths satisfy these invariants (`Good`, `nf_good`), so an equation
  in context gives the same normal form (`nf_basic`, `same_of_basic_context`).
- Out of an entity type, a path is its part in `S` followed by conversions after the
  first value type (`vtgt?_split`). An equation of `S` rewrites the first part, an
  equation of `Basic` keeps the normal form of the second (`splitEq_of_compClosure`).
-/

namespace DDD

namespace TypeList

variable {L : TypeList}

/-! ## Sound lists of value types -/

theorem mem_of_lookup {α β : Type} [BEq α] [LawfulBEq α] :
    ∀ {l : List (α × β)} {a : α} {b : β}, l.lookup a = some b → (a, b) ∈ l
  | [], _, _, h => by simp at h
  | (k, c) :: l, a, b, h => by
    rw [List.lookup_cons] at h
    by_cases hk : a = k
    · subst hk
      simp only [beq_self_eq_true] at h
      obtain rfl := Option.some.inj h
      exact List.mem_cons_self
    · have : (a == k) = false := by simpa using hk
      rw [this] at h
      exact List.mem_cons_of_mem _ (mem_of_lookup h)

theorem lookup_isSome {n : String} {d : TypeDecl} (h : L.lookup n = some d) :
    n ∈ L.decls.map (·.1) :=
  List.mem_map.mpr ⟨(n, d), mem_of_lookup h, rfl⟩

theorem lookup_builtinName (hL : L.Sound) {n : String} (h : n ∈ builtinNames) :
    L.lookup n = none := by
  cases hd : L.lookup n with
  | none => rfl
  | some d => exact absurd h (hL.notBuiltin _ (mem_of_lookup hd))

theorem base?_some {m : String} {b : ValueType} (h : L.base? m = some b) :
    L.lookup m = some (.over b) := by
  unfold base? at h
  split at h
  · rename_i b' hb
    obtain rfl := Option.some.inj h
    exact hb
  · exact absurd h (by simp)

theorem base?_isBuiltin (hL : L.Sound) {m : String} {b : ValueType} (h : L.base? m = some b) :
    b.isBuiltin = true :=
  hL.decl _ (mem_of_lookup (base?_some h))

theorem base?_not_builtinName (hL : L.Sound) {m : String} {b : ValueType}
    (h : L.base? m = some b) : m ∉ builtinNames := fun hm => by
  have := lookup_builtinName hL hm
  rw [base?_some h] at this
  exact absurd this (by simp)

theorem base?_builtinName (hL : L.Sound) {n : String} (h : n ∈ builtinNames) :
    L.base? n = none := by
  simp [base?, lookup_builtinName hL h]

theorem text_mem_builtinNames {b : ValueType} (h : b.isBuiltin = true) :
    b.text ∈ builtinNames := by
  cases b <;> simp_all [ValueType.isBuiltin, ValueType.text, builtinNames]

theorem text_inj {b b' : ValueType} (h : b.isBuiltin = true) (h' : b'.isBuiltin = true)
    (e : b.text = b'.text) : b = b' := by
  cases b <;> cases b' <;> simp_all [ValueType.isBuiltin, ValueType.text]

theorem isPlain_of_isBuiltin {b : ValueType} (h : b.isBuiltin = true) : b.isPlain = true := by
  cases b <;> simp_all [ValueType.isBuiltin, ValueType.isPlain]

theorem base?_ne {m : String} {b : ValueType} (hL : L.Sound) (h : L.base? m = some b)
    {n : String} (hn : n ∈ builtinNames) : m ≠ n := fun e =>
  base?_not_builtinName hL h (e ▸ hn)

theorem table?_some {v : ValueType} {n : String} {t : Table} (h : L.table? v n = some t) :
    t ∈ L.tables ∧ t.name = n ∧ t.source = v := by
  have hp := List.find?_some h
  simp only [Bool.and_eq_true, beq_iff_eq] at hp
  exact ⟨List.mem_of_find?_eq_some h, hp⟩

theorem table?_sound (hL : L.Sound) {v : ValueType} {n : String} {t : Table}
    (h : L.table? v n = some t) : L.TableSound t :=
  hL.table t (table?_some h).1

theorem table?_name (hL : L.Sound) {v : ValueType} {n : String} {t : Table}
    (h : L.table? v n = some t) :
    n ∉ builtinNames ∧ L.lookup n = none ∧ n ≠ "some" := by
  obtain ⟨-, hn, -⟩ := table?_some h
  obtain ⟨h₁, h₂, h₃, -⟩ := table?_sound hL h
  subst hn
  refine ⟨h₁, ?_, h₃⟩
  cases hd : L.lookup t.name with
  | none => rfl
  | some d => exact absurd (lookup_isSome hd) h₂

theorem table?_values (hL : L.Sound) {v : ValueType} {n : String} {t : Table}
    (h : L.table? v n = some t) : (L.values? v).isSome ∧ (L.values? t.target).isSome := by
  obtain ⟨-, -, hs⟩ := table?_some h
  obtain ⟨-, -, -, h₄, h₅, -⟩ := table?_sound hL h
  exact ⟨hs ▸ h₄, h₅⟩

/-- A finite type is `bool` or an enumeration. -/
theorem values?_isSome {v : ValueType} (h : (L.values? v).isSome) :
    v = .bool ∨ ∃ e vs, v = .named e ∧ L.lookup e = some (.enum vs) := by
  cases v with
  | bool => exact .inl rfl
  | named e =>
    simp only [values?] at h
    split at h
    · rename_i vs hvs
      exact .inr ⟨e, vs, rfl, hvs⟩
    · exact absurd h (by simp)
  | _ => simp [values?] at h

theorem isPlain_of_values? {v : ValueType} (h : (L.values? v).isSome) : v.isPlain = true := by
  rcases values?_isSome h with rfl | ⟨e, vs, rfl, -⟩ <;> rfl

theorem base?_of_values? {e : String} (h : (L.values? (.named e)).isSome) : L.base? e = none := by
  rcases values?_isSome h with h | ⟨e', vs, he, hl⟩
  · cases h
  · cases he
    simp [base?, hl]

theorem field?_some {v w : ValueType} {n : String} (h : L.field? v n = some w) :
    ∃ r fs, v = .named r ∧ L.fields? r = some fs := by
  cases v with
  | named r =>
    simp only [field?] at h
    cases hf : L.fields? r with
    | none => simp [hf] at h
    | some fs => exact ⟨r, fs, rfl, hf⟩
  | _ => simp [field?] at h

theorem base?_of_fields? {r : String} {fs : List (String × ValueType)}
    (h : L.fields? r = some fs) : L.base? r = none := by
  unfold fields? at h
  split at h
  · rename_i fs' hl
    simp [base?, hl]
  · exact absurd h (by simp)

/-! ## Conversions out of plain types -/

theorem builtinConv?_name {v w : ValueType} {n : String} (h : builtinConv? v n = some w) :
    n ∈ builtinNames := by
  unfold builtinConv? at h
  split at h <;> first | (simp [builtinNames]; done) | simp at h

theorem builtinConv?_isBuiltin {v w : ValueType} {n : String} (h : builtinConv? v n = some w) :
    w.isBuiltin = true := by
  unfold builtinConv? at h
  split at h <;> first | (obtain rfl := Option.some.inj h; rfl) | exact absurd h (by simp)

theorem coerce?_some {u w : ValueType} {n : String} (h : L.coerce? u n = some w) :
    (∃ m b, u = .named m ∧ L.base? m = some b ∧ n = b.text ∧ w = b) ∨
      (u.isBuiltin = true ∧ L.base? n = some u ∧ w = .named n) := by
  unfold coerce? at h
  split at h
  · rename_i m
    split at h
    · rename_i b hb
      split at h
      · rename_i hn
        exact .inl ⟨m, b, rfl, hb, hn, (Option.some.inj h).symm⟩
      · exact absurd h (by simp)
    · exact absurd h (by simp)
  · split at h
    · rename_i hu
      split at h
      · rename_i b hb
        split at h
        · rename_i hbu
          subst hbu
          exact .inr ⟨hu, hb, (Option.some.inj h).symm⟩
        · exact absurd h (by simp)
      · exact absurd h (by simp)
    · exact absurd h (by simp)

theorem coerce?_named {m : String} {b : ValueType} (hb : L.base? m = some b) :
    L.coerce? (.named m) b.text = some b := by
  simp [coerce?, hb]

theorem coerce?_builtin {b : ValueType} {x : String} (hb : b.isBuiltin = true)
    (hx : L.base? x = some b) : L.coerce? b x = some (.named x) := by
  cases b <;> simp_all [coerce?, ValueType.isBuiltin]

theorem plainConv?_cases {u w : ValueType} {n : String} (hn : n ≠ "some")
    (h : L.plainConv? u n = some w) :
    (n = "string" ∧ u ≠ .string ∧ w = .string) ∨
    (n ≠ "string" ∧ builtinConv? u n = some w) ∨
    (n ≠ "string" ∧ builtinConv? u n = none ∧ L.coerce? u n = some w) ∨
    (n ≠ "string" ∧ builtinConv? u n = none ∧ L.coerce? u n = none ∧
      ∃ t, L.table? u n = some t ∧ w = t.target) ∨
    (n ≠ "string" ∧ builtinConv? u n = none ∧ L.coerce? u n = none ∧ L.table? u n = none ∧
      L.field? u n = some w) := by
  unfold plainConv? at h
  rw [if_neg hn] at h
  by_cases hs : n = "string"
  · rw [if_pos hs] at h
    split at h
    · exact absurd h (by simp)
    · rename_i hu
      exact .inl ⟨hs, hu, (Option.some.inj h).symm⟩
  · rw [if_neg hs] at h
    right
    cases hb : builtinConv? u n with
    | some w' =>
      rw [hb] at h
      exact .inl ⟨hs, by simpa using h⟩
    | none =>
      rw [hb] at h
      right
      cases hc : L.coerce? u n with
      | some w' =>
        rw [hc] at h
        exact .inl ⟨hs, rfl, by simpa using h⟩
      | none =>
        rw [hc] at h
        right
        cases ht : L.table? u n with
        | some t =>
          rw [ht] at h
          exact .inl ⟨hs, rfl, rfl, t, rfl, by simpa using h.symm⟩
        | none =>
          rw [ht] at h
          exact .inr ⟨hs, rfl, rfl, rfl, by simpa using h⟩

theorem conv?_of_plain {u : ValueType} (hu : u.isPlain = true) (n : String) :
    L.conv? u n = L.plainConv? u n := conv?_plain hu n

theorem isPlain_of_conv? {p q : ValueType} {n : String} (h : L.conv? p n = some q)
    (hq : q.isPlain = true) : p.isPlain = true := by
  cases p with
  | optional u =>
    obtain ⟨-, w, -, -, rfl⟩ := conv?_optional h
    exact absurd hq (by simp [ValueType.isPlain])
  | _ => rfl

theorem isPlain_of_convTgt? : ∀ {p q : ValueType} {l : List String}, L.convTgt? p l = some q →
    q.isPlain = true → p.isPlain = true
  | _, _, [], h, hq => by rw [convTgt?_nil, Option.some.injEq] at h; exact h ▸ hq
  | p, q, n :: ns, h, hq => by
    rw [convTgt?_cons] at h
    cases hc : L.conv? p n with
    | none => simp [hc] at h
    | some p' =>
      rw [hc, Option.bind_some] at h
      exact isPlain_of_conv? hc (isPlain_of_convTgt? h hq)

/-- The source of a lift is plain. -/
theorem isPlain_of_conv?_optional {p q : ValueType} {n : String}
    (h : L.conv? (.optional p) n = some q) : p.isPlain = true :=
  (conv?_optional h).1

theorem conv?_lift {p w : ValueType} {n : String} (hp : p.isPlain = true) (hw : w.isPlain = true)
    (h : L.conv? p n = some w) : L.conv? (.optional p) n = some (.optional w) := by
  rw [conv?_plain hp] at h
  simp [conv?, hp, h, hw]

theorem conv?_of_lift {p w : ValueType} {n : String}
    (h : L.conv? (.optional p) n = some (.optional w)) :
    p.isPlain = true ∧ w.isPlain = true ∧ L.conv? p n = some w := by
  obtain ⟨hp, w', hw', hpw, e⟩ := conv?_optional h
  obtain rfl : w = w' := ValueType.optional.inj e
  exact ⟨hp, hpw, by rw [conv?_plain hp, hw']⟩

theorem conv?_lift_iff {p w : ValueType} {n : String} (hp : p.isPlain = true)
    (hw : w.isPlain = true) : L.conv? (.optional p) n = some (.optional w) ↔ L.conv? p n = some w :=
  ⟨fun h => (conv?_of_lift h).2.2, conv?_lift hp hw⟩

/-- A path out of an optional type is a path of lifts. -/
theorem convTgt?_of_optional : ∀ {p r : ValueType} {l : List String},
    L.convTgt? (.optional p) l = some r → ∃ q, r = .optional q ∧ L.convTgt? p l = some q ∧
      "some" ∉ l ∧ (l ≠ [] → p.isPlain = true ∧ q.isPlain = true)
  | p, r, [], h => ⟨p, (Option.some.inj h).symm, rfl, by simp, by simp⟩
  | p, r, n :: ns, h => by
    rw [convTgt?_cons] at h
    cases hc : L.conv? (.optional p) n with
    | none => simp [hc] at h
    | some y =>
      rw [hc, Option.bind_some] at h
      obtain ⟨hp, w, hw, hwp, rfl⟩ := conv?_optional hc
      obtain ⟨q, rfl, hq, hs, hpl⟩ := convTgt?_of_optional h
      have hpw : L.conv? p n = some w := by rw [conv?_plain hp, hw]
      have hn : n ≠ "some" := by
        rintro rfl
        simp only [plainConv?, if_true, Option.some.injEq] at hw
        subst hw
        simp [ValueType.isPlain] at hwp
      refine ⟨q, rfl, by rw [convTgt?_cons, hpw, Option.bind_some, hq], ?_, fun _ => ⟨hp, ?_⟩⟩
      · simp only [List.mem_cons, not_or]
        exact ⟨fun e => hn e.symm, hs⟩
      · cases ns with
        | nil => rw [convTgt?_nil, Option.some.injEq] at hq; exact hq ▸ hwp
        | cons _ _ => exact (hpl (by simp)).2

theorem conv?_down (hL : L.Sound) {m : String} {b : ValueType} (hb : L.base? m = some b) :
    L.conv? (.named m) b.text = some b := by
  have hbb := base?_isBuiltin hL hb
  have hs : b.text ≠ "some" := fun e => by
    have := text_mem_builtinNames hbb
    rw [e] at this
    simp [builtinNames] at this
  change L.plainConv? (.named m) b.text = some b
  unfold plainConv?
  rw [if_neg hs]
  by_cases hst : b.text = "string"
  · rw [if_pos hst]
    obtain rfl : b = .string := text_inj hbb rfl hst
    simp
  · rw [if_neg hst]
    simp [builtinConv?, coerce?_named hb]

theorem conv?_up (hL : L.Sound) {x : String} {b : ValueType} (hb : L.base? x = some b)
    (hx : x ≠ "some") : L.conv? b x = some (.named x) := by
  have hbb := base?_isBuiltin hL hb
  rw [conv?_plain (isPlain_of_isBuiltin hbb)]
  unfold plainConv?
  rw [if_neg hx, if_neg (base?_ne hL hb (by simp [builtinNames]))]
  have : builtinConv? b x = none := by
    cases h : builtinConv? b x with
    | none => rfl
    | some w => exact absurd (builtinConv?_name h) (base?_not_builtinName hL hb)
  simp [this, coerce?_builtin hbb hb]

theorem conv?_table (hL : L.Sound) {p : ValueType} {n : String} {t : Table}
    (ht : L.table? p n = some t) : L.conv? p n = some t.target := by
  obtain ⟨hp, -⟩ := table?_values hL ht
  obtain ⟨hn₁, hn₂, hn₃⟩ := table?_name hL ht
  rw [conv?_plain (isPlain_of_values? hp)]
  unfold plainConv?
  rw [if_neg hn₃, if_neg (by rintro rfl; simp [builtinNames] at hn₁)]
  have h₁ : builtinConv? p n = none := by
    cases h : builtinConv? p n with
    | none => rfl
    | some w => exact absurd (builtinConv?_name h) hn₁
  have h₂ : L.coerce? p n = none := by
    cases h : L.coerce? p n with
    | none => rfl
    | some w =>
      rcases coerce?_some h with ⟨m, b, rfl, hb, rfl, -⟩ | ⟨-, hb, -⟩
      · exact absurd (base?_of_values? hp) (by simp [hb])
      · simp [base?, hn₂] at hb
  simp [h₁, h₂, ht]

/-! ## The tests of the rules -/

theorem cancelsPlain_true {x y : String} {u : ValueType} (h : L.cancelsPlain x y u = true) :
    (∃ m b, u = .named m ∧ L.base? m = some b ∧ x = b.text ∧ y = m) ∨
      (L.base? x = some u ∧ y = u.text) := by
  simp only [cancelsPlain, Bool.or_eq_true] at h
  rcases h with h | h
  · left
    split at h
    · rename_i m
      obtain ⟨b, hb, hx⟩ := (Option.any_eq_true _ _).mp h
      simp only [Bool.and_eq_true, beq_iff_eq] at hx
      exact ⟨m, b, rfl, hb, hx.1, hx.2⟩
    · exact absurd h (by simp)
  · right
    obtain ⟨b, hb, hx⟩ := (Option.any_eq_true _ _).mp h
    simp only [Bool.and_eq_true, beq_iff_eq] at hx
    obtain ⟨rfl, rfl⟩ := hx
    exact ⟨hb, rfl⟩

theorem coercionPlain_true {x : String} {u : ValueType} (h : L.coercionPlain x u = true) :
    (∃ m b, u = .named m ∧ L.base? m = some b ∧ x = b.text) ∨ L.base? x = some u := by
  simp only [coercionPlain, Bool.or_eq_true] at h
  rcases h with h | h
  · left
    split at h
    · rename_i m
      obtain ⟨b, hb, hx⟩ := (Option.any_eq_true _ _).mp h
      exact ⟨m, b, rfl, hb, by simpa using hx⟩
    · exact absurd h (by simp)
  · right
    obtain ⟨b, hb, hx⟩ := (Option.any_eq_true _ _).mp h
    obtain rfl : b = u := by simpa using hx
    exact hb

theorem lifted_of_isPlain {P : ValueType → Bool} {u : ValueType} (hu : u.isPlain = true) :
    lifted P u = P u := by
  cases u <;> first | rfl | exact absurd hu (by simp [ValueType.isPlain])

theorem lifted_optional {P : ValueType → Bool} {u : ValueType} (hu : u.isPlain = true) :
    lifted P (.optional u) = P u := by
  simp [lifted, hu]

theorem exists_of_lifted {P : ValueType → Bool} {u : ValueType} (h : lifted P u = true) :
    ∃ p, P p = true ∧ p.isPlain = true ∧ u.plain = p := by
  cases u with
  | optional u' =>
    simp only [lifted, Bool.and_eq_true] at h
    exact ⟨u', h.2, h.1, rfl⟩
  | _ => exact ⟨_, h, rfl, rfl⟩

theorem lifted_and {P Q : ValueType → Bool} {u : ValueType} (h₁ : lifted P u = true)
    (h₂ : lifted Q u = true) : ∃ p, P p = true ∧ Q p = true ∧ p.isPlain = true ∧ u.plain = p := by
  cases u with
  | optional u' =>
    simp only [lifted, Bool.and_eq_true] at h₁ h₂
    exact ⟨u', h₁.2, h₂.2, h₁.1, rfl⟩
  | _ => exact ⟨_, h₁, h₂, rfl, rfl⟩

theorem lifted_congr {P Q R : ValueType → Bool} {u : ValueType} (h : lifted P u = true)
    (hQR : ∀ p, P p = true → Q p = R p) : lifted Q u = lifted R u := by
  cases u with
  | optional u' =>
    simp only [lifted, Bool.and_eq_true] at h ⊢
    rw [hQR _ h.2]
  | _ => exact hQR _ h

theorem plain_of_isPlain {u : ValueType} (hu : u.isPlain = true) : u.plain = u := by
  cases u <;> first | rfl | exact absurd hu (by simp [ValueType.isPlain])

theorem isTable_optional {u : ValueType} (hu : u.isPlain = true) (n : String) :
    L.isTable (.optional u) n = L.isTable u n := by
  unfold isTable
  rw [plain_of_isPlain hu]
  rfl

/-! ## Paths of tables -/

theorem tablesTgt?_append : ∀ (v : ValueType) (P Q : List String),
    L.tablesTgt? v (P ++ Q) = (L.tablesTgt? v P).bind fun w => L.tablesTgt? w Q
  | _, [], _ => rfl
  | v, n :: P, Q => by
    simp only [List.cons_append, tablesTgt?]
    cases L.table? v n with
    | none => rfl
    | some t => exact tablesTgt?_append t.target P Q

theorem tablesApply?_append : ∀ (v : ValueType) (P Q : List String) (x : String),
    L.tablesApply? v (P ++ Q) x =
      (L.tablesTgt? v P).bind fun w => (L.tablesApply? v P x).bind (L.tablesApply? w Q)
  | _, [], _, _ => rfl
  | v, n :: P, Q, x => by
    simp only [List.cons_append, tablesApply?, tablesTgt?]
    cases L.table? v n with
    | none => rfl
    | some t =>
      simp only [Option.bind_some]
      cases t.rows.lookup x with
      | none => cases L.tablesTgt? t.target P <;> rfl
      | some y => exact tablesApply?_append t.target P Q y

theorem tablesFn?_isSome {v : ValueType} {ns : List String} :
    (L.tablesFn? v ns).isSome ↔ (L.values? v).isSome ∧ (L.tablesTgt? v ns).isSome := by
  unfold tablesFn?
  cases L.values? v <;> cases L.tablesTgt? v ns <;> simp

theorem tablesFn?_eq {v : ValueType} {ns ns' : List String} {xs : List String}
    (hv : L.values? v = some xs) (h : L.tablesFn? v ns = L.tablesFn? v ns') :
    L.tablesTgt? v ns = L.tablesTgt? v ns' ∧
      (L.tablesTgt? v ns).isSome → ∀ x ∈ xs, L.tablesApply? v ns x = L.tablesApply? v ns' x := by
  intro ⟨_, hs⟩ x hx
  unfold tablesFn? at h
  rw [hv, Option.bind_some, Option.bind_some] at h
  cases h₁ : L.tablesTgt? v ns with
  | none => simp [h₁] at hs
  | some w =>
    cases h₂ : L.tablesTgt? v ns' with
    | none => simp [h₁, h₂] at h
    | some w' =>
      simp only [h₁, h₂, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
      exact (List.map_inj_left.mp h.2) x hx

theorem tablesTgt?_of_tablesFn? {v : ValueType} {ns ns' : List String}
    (h : L.tablesFn? v ns = L.tablesFn? v ns') (hs : (L.tablesFn? v ns).isSome) :
    L.tablesTgt? v ns = L.tablesTgt? v ns' := by
  obtain ⟨hv, -⟩ := tablesFn?_isSome.mp hs
  obtain ⟨xs, hxs⟩ := Option.isSome_iff_exists.mp hv
  unfold tablesFn? at h
  rw [hxs, Option.bind_some, Option.bind_some] at h
  cases h₁ : L.tablesTgt? v ns <;> cases h₂ : L.tablesTgt? v ns' <;> simp_all

/-- Paths of tables that compute the same function, followed by the same path. -/
theorem tablesFn?_append_left {v : ValueType} {P P' : List String}
    (h : L.tablesFn? v P = L.tablesFn? v P') (Q : List String) :
    L.tablesFn? v (P ++ Q) = L.tablesFn? v (P' ++ Q) := by
  unfold tablesFn? at h ⊢
  cases hv : L.values? v with
  | none => rfl
  | some xs =>
    rw [hv, Option.bind_some, Option.bind_some] at h
    simp only [Option.bind_some, tablesTgt?_append]
    cases h₁ : L.tablesTgt? v P with
    | none =>
      cases h₂ : L.tablesTgt? v P' with
      | none => rfl
      | some w' => simp [h₁, h₂] at h
    | some w =>
      cases h₂ : L.tablesTgt? v P' with
      | none => simp [h₁, h₂] at h
      | some w' =>
        simp only [h₁, h₂, Option.map_some, Option.some.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl, hm⟩ := h
        simp only [Option.bind_some]
        congr 1
        funext w''
        congr 1
        apply List.map_inj_left.mpr
        intro x hx
        rw [tablesApply?_append, tablesApply?_append, h₁, h₂, Option.bind_some, Option.bind_some,
          (List.map_inj_left.mp hm) x hx]

theorem tablesApply?_mem (hL : L.Sound) : ∀ {P : List String} {v w : ValueType} {x y : String},
    L.tablesTgt? v P = some w → x ∈ (L.values? v).getD [] → L.tablesApply? v P x = some y →
      y ∈ (L.values? w).getD []
  | [], v, w, x, y, hw, hx, hy => by
    obtain rfl : v = w := Option.some.inj hw
    obtain rfl : x = y := Option.some.inj hy
    exact hx
  | n :: P, v, w, x, y, hw, hx, hy => by
    simp only [tablesTgt?] at hw
    simp only [tablesApply?] at hy
    cases ht : L.table? v n with
    | none => simp [ht] at hw
    | some t =>
      rw [ht, Option.bind_some] at hw hy
      cases hr : t.rows.lookup x with
      | none => simp [hr] at hy
      | some y' =>
        rw [hr, Option.bind_some] at hy
        have hy' := (table?_sound hL ht).2.2.2.2.2.2.2.1 _ (mem_of_lookup hr)
        exact tablesApply?_mem hL hw hy' hy

/-- A path of tables followed by paths of tables that compute the same function. -/
theorem tablesFn?_append_right (hL : L.Sound) {v w : ValueType} {P Q Q' : List String}
    (hP : L.tablesTgt? v P = some w) (h : L.tablesFn? w Q = L.tablesFn? w Q')
    (hs : (L.tablesFn? w Q).isSome) : L.tablesFn? v (P ++ Q) = L.tablesFn? v (P ++ Q') := by
  obtain ⟨hw, hq⟩ := tablesFn?_isSome.mp hs
  obtain ⟨ys, hys⟩ := Option.isSome_iff_exists.mp hw
  have htgt := tablesTgt?_of_tablesFn? h hs
  have happ := tablesFn?_eq hys h ⟨htgt, hq⟩
  unfold tablesFn?
  cases hv : L.values? v with
  | none => rfl
  | some xs =>
    simp only [Option.bind_some, tablesTgt?_append, hP, htgt]
    congr 1
    funext w''
    congr 1
    apply List.map_inj_left.mpr
    intro x hx
    rw [tablesApply?_append, tablesApply?_append, hP, Option.bind_some, Option.bind_some]
    cases hy : L.tablesApply? v P x with
    | none => rfl
    | some y =>
      simp only [Option.bind_some]
      exact happ y (by simpa [hys] using tablesApply?_mem hL hP (by simpa [hv] using hx) hy)

theorem tablesFn?_append_isSome {v w : ValueType} {P Q : List String}
    (hP : L.tablesTgt? v P = some w) (hv : (L.values? v).isSome)
    (hQ : (L.tablesTgt? w Q).isSome) : (L.tablesFn? v (P ++ Q)).isSome :=
  tablesFn?_isSome.mpr ⟨hv, by rw [tablesTgt?_append, hP, Option.bind_some]; exact hQ⟩

theorem values?_tablesTgt? (hL : L.Sound) : ∀ {P : List String} {v w : ValueType},
    (L.values? v).isSome → L.tablesTgt? v P = some w → (L.values? w).isSome
  | [], v, w, hv, h => by obtain rfl : v = w := Option.some.inj h; exact hv
  | n :: P, v, w, hv, h => by
    simp only [tablesTgt?] at h
    cases ht : L.table? v n with
    | none => simp [ht] at h
    | some t =>
      rw [ht, Option.bind_some] at h
      exact values?_tablesTgt? hL (table?_values hL ht).2 h

/-- A path of tables is a path of conversions, plain or lifted. -/
theorem convTgt?_tables (hL : L.Sound) : ∀ {P : List String} {p q : ValueType},
    (L.values? p).isSome → L.tablesTgt? p P = some q →
      L.convTgt? p P = some q ∧ L.convTgt? (.optional p) P = some (.optional q)
  | [], p, q, _, h => by obtain rfl : p = q := Option.some.inj h; exact ⟨rfl, rfl⟩
  | n :: P, p, q, hp, h => by
    simp only [tablesTgt?] at h
    cases ht : L.table? p n with
    | none => simp [ht] at h
    | some t =>
      rw [ht, Option.bind_some] at h
      have hc := conv?_table hL ht
      have htv := (table?_values hL ht).2
      obtain ⟨ih₁, ih₂⟩ := convTgt?_tables hL htv h
      refine ⟨by rw [convTgt?_cons, hc, Option.bind_some, ih₁], ?_⟩
      rw [convTgt?_cons, conv?_lift (isPlain_of_values? hp) (isPlain_of_values? htv) hc,
        Option.bind_some, ih₂]

theorem lifted_eq_plain {P Q : ValueType → Bool} {u : ValueType} (h : lifted P u = true) :
    lifted Q u = Q u.plain := by
  cases u with
  | optional u' =>
    simp only [lifted, Bool.and_eq_true] at h ⊢
    simp [h.1, ValueType.plain]
  | _ => rfl

/-- The type at the end of a run of tables out of `src`. -/
theorem tables_end (hL : L.Sound) {src u : ValueType} {ns : List String}
    (hf : lifted (fun p => (L.tablesFn? p ns).isSome) src = true)
    (ht : L.convTgt? src ns = some u) :
    (L.values? src.plain).isSome ∧ L.tablesTgt? src.plain ns = some u.plain ∧
      (L.values? u.plain).isSome ∧ (src.isPlain = true → u = u.plain) ∧
      (src.isPlain = false → u = .optional u.plain) := by
  obtain ⟨p, hp, hpl, hsp⟩ := exists_of_lifted hf
  obtain ⟨hv, hq⟩ := tablesFn?_isSome.mp hp
  obtain ⟨q, hq⟩ := Option.isSome_iff_exists.mp hq
  obtain ⟨h₁, h₂⟩ := convTgt?_tables hL hv hq
  have hqv := values?_tablesTgt? hL hv hq
  have hqp := isPlain_of_values? hqv
  by_cases hs : src.isPlain = true
  · obtain rfl : src = p := (plain_of_isPlain hs).symm.trans hsp
    rw [h₁] at ht
    obtain rfl := Option.some.inj ht
    rw [plain_of_isPlain hs, plain_of_isPlain hqp]
    exact ⟨hv, hq, hqv, fun _ => rfl, fun h => absurd hs (by simp [h])⟩
  · obtain ⟨s', rfl⟩ : ∃ s', src = .optional s' := by
      cases src <;> simp_all [ValueType.isPlain]
    obtain rfl : s' = p := hsp
    rw [h₂] at ht
    obtain rfl := Option.some.inj ht
    exact ⟨hv, hq, hqv, fun h => absurd h hs, fun _ => rfl⟩

/-! ## Reduced stacks -/

variable (L) in
/-- The step `t` does not reduce with the stack `s` below it: a conversion that `push`
puts on `s` as it is, or a run of tables, plain or lifted, that is not the identity and
does not follow a run of tables. -/
def TokRed (t : Tok) (s : List Tok) : Prop :=
  match t.table with
  | true => (∀ t' ∈ s.head?, t'.table = false) ∧
      lifted (fun p => (L.tablesFn? p t.names).isSome) t.src = true ∧
      (lifted (L.identityPlain t.names) t.src && L.convTgt? t.src t.names == some t.src) = false
  | false => ∃ x, t.names = [x] ∧ x ≠ "some" ∧ L.isTable t.src x = false ∧ L.push t.src x s = t :: s

variable (L) in
/-- A reduced stack: no step reduces with the steps below it. -/
def Red : List Tok → Prop
  | [] => True
  | t :: s => Red s ∧ L.TokRed t s

theorem tokRed_table {t : Tok} {s : List Tok} (h : L.TokRed t s) (ht : t.table = true) :
    (∀ t' ∈ s.head?, t'.table = false) ∧
      lifted (fun p => (L.tablesFn? p t.names).isSome) t.src = true ∧
      (lifted (L.identityPlain t.names) t.src &&
        L.convTgt? t.src t.names == some t.src) = false := by
  unfold TokRed at h
  rw [ht] at h
  exact h

theorem tokRed_conv {t : Tok} {s : List Tok} (h : L.TokRed t s) (ht : t.table = false) :
    ∃ x, t.names = [x] ∧ x ≠ "some" ∧ L.isTable t.src x = false ∧ L.push t.src x s = t :: s := by
  unfold TokRed at h
  rw [ht] at h
  exact h

/-! ## Pushing onto a run of tables -/

/-- The name of a table is neither a coercion nor `datetime`. -/
theorem table_tests (hL : L.Sound) {p : ValueType} {x : String} (hx : (L.tablesFn? p [x]).isSome)
    (n : String) :
    L.cancelsPlain x n p = false ∧ L.coercionPlain x p = false ∧ x ≠ "datetime" := by
  obtain ⟨hv, ht⟩ := tablesFn?_isSome.mp hx
  simp only [tablesTgt?] at ht
  cases htb : L.table? p x with
  | none => simp [htb] at ht
  | some t =>
    obtain ⟨hx₁, hx₂, -⟩ := table?_name hL htb
    have hbx : L.base? x = none := by simp [base?, hx₂]
    refine ⟨?_, ?_, fun e => hx₁ (e ▸ by simp [builtinNames])⟩
    · cases h : L.cancelsPlain x n p with
      | false => rfl
      | true =>
        rcases cancelsPlain_true h with ⟨m, b, rfl, hb, -, -⟩ | ⟨hb, -⟩
        · rw [base?_of_values? hv] at hb; cases hb
        · rw [hbx] at hb; cases hb
    · cases h : L.coercionPlain x p with
      | false => rfl
      | true =>
        rcases coercionPlain_true h with ⟨m, b, rfl, hb, -⟩ | hb
        · rw [base?_of_values? hv] at hb; cases hb
        · rw [hbx] at hb; cases hb

/-- `push` on a run of tables extends it by a table, or puts a conversion on it. -/
theorem push_tableTok (hL : L.Sound) {t : Tok} (ht : t.table = true)
    (hf : lifted (fun p => (L.tablesFn? p t.names).isSome) t.src = true) (u : ValueType)
    (n : String) (s : List Tok) :
    L.push u n (t :: s) = if L.isTable u n then L.block t.src (t.names ++ [n]) s
      else ⟨u, [n], false⟩ :: t :: s := by
  by_cases hi : L.isTable u n = true
  · simp [push, ht, hi]
  · have hi' : L.isTable u n = false := by simpa using hi
    rw [push, ht, hi']
    simp only [Bool.and_false, Bool.false_eq_true, if_false]
    split
    · rename_i x hx
      obtain ⟨p, hp, -, hsp⟩ := exists_of_lifted hf
      rw [hx] at hp
      obtain ⟨h₁, h₂, h₃⟩ := table_tests hL hp n
      have e₁ : lifted (L.cancelsPlain x n) t.src = false := by
        rw [lifted_eq_plain hf, hsp, h₁]
      have e₂ : lifted (L.coercionPlain x) t.src = false := by
        rw [lifted_eq_plain hf, hsp, h₂]
      simp [e₁, e₂, h₃]
    · rfl

/-! ## Pushing a conversion onto a reduced stack -/

theorem push_conv {u src : ValueType} {n x : String} {r : List Tok} (hp : src.isPlain = true) :
    L.push u n (⟨src, [x], false⟩ :: r) =
      if (L.cancelsPlain x n src && L.convTgt? src [x, n] == some src) = true then r
      else if (n == "string" && L.coercionPlain x src &&
          L.convTgt? src [x, n] == L.convTgt? src [n]) = true then L.push src n r
      else if (x == "datetime" && (n == "date" || n == "time") && src == .timestamp &&
          L.convTgt? src [x, n] == L.convTgt? src [n]) = true then ⟨src, [n], false⟩ :: r
      else if L.isTable u n = true then L.block u [n] (⟨src, [x], false⟩ :: r)
      else ⟨u, [n], false⟩ :: ⟨src, [x], false⟩ :: r := by
  rw [push]
  simp only [Bool.false_and, Bool.false_eq_true, if_false, lifted_of_isPlain hp]

theorem push_nil (u : ValueType) (n : String) :
    L.push u n [] = if L.isTable u n = true then L.block u [n] [] else [⟨u, [n], false⟩] := by
  rw [push]

/-- The step on top of a reduced stack whose end is plain: a run of tables, or a
conversion out of a plain type. -/
theorem top_cases (hL : L.Sound) {v u : ValueType} {t : Tok} {r : List Tok}
    (hr : L.Red (t :: r)) (hs : Schema.Typed L v (t :: r) u) (hu : u.isPlain = true) :
    (t.table = true ∧ lifted (fun p => (L.tablesFn? p t.names).isSome) t.src = true ∧
      (L.values? u).isSome) ∨
    (∃ src x, t = ⟨src, [x], false⟩ ∧ src.isPlain = true ∧ L.conv? src x = some u ∧
      x ≠ "some" ∧ L.isTable src x = false ∧ L.push src x r = t :: r) := by
  obtain ⟨-, hr₂⟩ := hr
  obtain ⟨-, hs₂⟩ := hs
  cases ht : t.table with
  | true =>
    obtain ⟨-, hf, -⟩ := tokRed_table hr₂ ht
    obtain ⟨-, -, hv, -⟩ := tables_end hL hf hs₂
    exact .inl ⟨rfl, hf, by rwa [plain_of_isPlain hu] at hv⟩
  | false =>
    obtain ⟨x, hx, hxs, hxt, hpush⟩ := tokRed_conv hr₂ ht
    obtain ⟨src, names, tb⟩ := t
    simp only at ht hx hxt hpush hs₂
    subst ht hx
    rw [convTgt?_singleton] at hs₂
    exact .inr ⟨src, x, rfl, isPlain_of_conv? hs₂ hu, hs₂, hxs, hxt, hpush⟩

theorem conv?_builtin {u w : ValueType} {n : String} (hu : u.isPlain = true)
    (h : builtinConv? u n = some w) : L.conv? u n = some w := by
  have hn := builtinConv?_name h
  rw [conv?_plain hu]
  unfold plainConv?
  rw [if_neg (by rintro rfl; simp [builtinNames] at hn),
    if_neg (by rintro rfl; unfold builtinConv? at h; split at h <;> simp_all), h]
  rfl

theorem not_named_of_conv?_named (hL : L.Sound) {src : ValueType} {m x : String}
    {b : ValueType} (hb : L.base? m = some b) (hsrc : src.isPlain = true) (hx : x ≠ "some")
    (h : L.conv? src x = some (.named m)) :
    (src = b ∧ x = m) ∨ ∃ r fs, src = .named r ∧ L.fields? r = some fs := by
  rw [conv?_plain hsrc] at h
  rcases plainConv?_cases hx h with ⟨-, -, h⟩ | ⟨-, h⟩ | ⟨-, -, h⟩ | ⟨-, -, -, t, ht, h⟩ |
      ⟨-, -, -, -, h⟩
  · cases h
  · cases builtinConv?_isBuiltin h
  · rcases coerce?_some h with ⟨m', b', rfl, hb', rfl, e⟩ | ⟨hu, hb', e⟩
    · have := base?_isBuiltin hL hb'
      rw [← e] at this
      cases this
    · cases e
      rw [hb] at hb'
      exact .inl ⟨(Option.some.inj hb').symm, rfl⟩
  · have := (table?_values hL ht).2
    rw [← h] at this
    rw [base?_of_values? this] at hb
    cases hb
  · exact .inr (field?_some h)

theorem record_tests (hL : L.Sound) {r : String} {fs : List (String × ValueType)}
    (hr : L.fields? r = some fs)
    (x n : String) :
    L.cancelsPlain x n (.named r) = false ∧ L.coercionPlain x (.named r) = false := by
  have hb := base?_of_fields? hr
  constructor
  · cases h : L.cancelsPlain x n (.named r) with
    | false => rfl
    | true =>
      rcases cancelsPlain_true h with ⟨m, b, e, hb', -, -⟩ | ⟨hb', -⟩
      · cases e; rw [hb] at hb'; cases hb'
      · cases base?_isBuiltin hL hb'
  · cases h : L.coercionPlain x (.named r) with
    | false => rfl
    | true =>
      rcases coercionPlain_true h with ⟨m, b, e, hb', -⟩ | hb'
      · cases e; rw [hb] at hb'; cases hb'
      · cases base?_isBuiltin hL hb'

theorem isTable_coerce {u w : ValueType} {n : String} (hu : u.isPlain = true)
    (h : L.coerce? u n = some w) : L.isTable u n = false := by
  simp [isTable, plain_of_isPlain hu, h]

theorem isTable_builtin {u w : ValueType} {n : String} (hu : u.isPlain = true)
    (h : builtinConv? u n = some w) : L.isTable u n = false := by
  simp [isTable, plain_of_isPlain hu, h]

theorem isTable_of_table? (hL : L.Sound) {u : ValueType} {n : String} {t : Table}
    (ht : L.table? u n = some t) : L.isTable u n = true := by
  obtain ⟨hv, -⟩ := table?_values hL ht
  obtain ⟨hn₁, hn₂, hn₃⟩ := table?_name hL ht
  have h₁ : builtinConv? u n = none := by
    cases h : builtinConv? u n with
    | none => rfl
    | some w => exact absurd (builtinConv?_name h) hn₁
  have h₂ : L.coerce? u n = none := by
    cases h : L.coerce? u n with
    | none => rfl
    | some w =>
      rcases coerce?_some h with ⟨m, b, rfl, hb, rfl, -⟩ | ⟨-, hb, -⟩
      · exact absurd (base?_of_values? hv) (by simp [hb])
      · simp [base?, hn₂] at hb
  have hs : n ≠ "string" := by rintro rfl; simp [builtinNames] at hn₁
  simp [isTable, plain_of_isPlain (isPlain_of_values? hv), h₁, h₂, ht, hn₃, hs]

theorem conv?_string {u : ValueType} (hu : u.isPlain = true) (h : u ≠ .string) :
    L.conv? u "string" = some .string := by
  rw [conv?_plain hu]
  simp [plainConv?, h]

theorem tok_ne {src b : ValueType} {x m : String} (h : ¬ (src = b ∧ x = m)) :
    (⟨src, [x], false⟩ : Tok) ≠ ⟨b, [m], false⟩ := fun e => by
  obtain ⟨h₁, h₂, -⟩ := Tok.mk.inj e
  exact h ⟨h₁, List.singleton_inj.mp h₂⟩

/-- A coercion to the base of a named type cancels a coercion into the named type below
it, and otherwise goes on the stack. -/
theorem push_down (hL : L.Sound) {m : String} {b : ValueType} (hb : L.base? m = some b)
    {v : ValueType} {s : List Tok} (hr : L.Red s) (hs : Schema.Typed L v s (.named m)) :
    L.push (.named m) b.text s =
      if s.head? = some ⟨b, [m], false⟩ then s.tail else ⟨.named m, [b.text], false⟩ :: s := by
  have hi : L.isTable (.named m) b.text = false := isTable_coerce rfl (coerce?_named hb)
  cases s with
  | nil => simp [push_nil, hi]
  | cons t r =>
    rcases top_cases hL hr hs rfl with ⟨ht, hf, -⟩ | ⟨src, x, rfl, hp, hc, hx, -, -⟩
    · rw [push_tableTok hL ht hf, hi]
      have : t ≠ ⟨b, [m], false⟩ := fun e => by rw [e] at ht; cases ht
      simp [this]
    · rw [push_conv hp]
      by_cases he : src = b ∧ x = m
      · have h₁ : L.cancelsPlain x b.text src = true := by
          rw [he.1, he.2]; simp [cancelsPlain, hb]
        have h₂ : L.convTgt? src [x, b.text] = some src := by
          rw [convTgt?_cons, hc, Option.bind_some, convTgt?_singleton, he.1]
          exact conv?_down hL hb
        have h₃ : (⟨src, [x], false⟩ : Tok) = ⟨b, [m], false⟩ := by rw [he.1, he.2]
        simp [h₁, h₂, h₃]
      · have h₁ : L.cancelsPlain x b.text src = false := by
          cases h : L.cancelsPlain x b.text src with
          | false => rfl
          | true =>
            exfalso
            rcases cancelsPlain_true h with ⟨m', b', rfl, hb', -, e⟩ | ⟨hb', e⟩
            · exact base?_not_builtinName hL hb' (e ▸ text_mem_builtinNames (base?_isBuiltin hL hb))
            · have := text_inj (base?_isBuiltin hL hb) (base?_isBuiltin hL hb') e
              rw [conv?_up hL hb' hx] at hc
              exact he ⟨this.symm, ValueType.named.inj (Option.some.inj hc)⟩
        have h₂ : L.coercionPlain x src = false := by
          cases h : L.coercionPlain x src with
          | false => rfl
          | true =>
            exfalso
            rcases coercionPlain_true h with ⟨m', b', rfl, hb', rfl⟩ | hb'
            · rw [conv?_down hL hb'] at hc
              have := base?_isBuiltin hL hb'
              rw [Option.some.inj hc] at this
              cases this
            · rw [conv?_up hL hb' hx] at hc
              obtain rfl := ValueType.named.inj (Option.some.inj hc)
              rw [hb] at hb'
              exact he ⟨(Option.some.inj hb').symm, rfl⟩
        have h₃ : ¬ (x = "datetime" ∧ src = .timestamp) := by
          rintro ⟨rfl, rfl⟩
          rw [conv?_builtin (w := .datetime) rfl rfl] at hc
          cases hc
        rw [if_neg (by simp [h₁]), if_neg (by simp [h₂]), if_neg (by
          intro h
          simp only [Bool.and_eq_true, beq_iff_eq] at h
          exact h₃ ⟨h.1.1.1, h.1.2⟩), if_neg (by simp [hi])]
        simp [tok_ne he]

/-- A coercion into a named type cancels a coercion to its base below it, and otherwise
goes on the stack. -/
theorem push_up (hL : L.Sound) {m : String} {b : ValueType} (hb : L.base? m = some b)
    (hm : m ≠ "some") {v : ValueType} {s : List Tok} (hr : L.Red s)
    (hs : Schema.Typed L v s b) :
    L.push b m s =
      if s.head? = some ⟨.named m, [b.text], false⟩ then s.tail else ⟨b, [m], false⟩ :: s := by
  have hbb := base?_isBuiltin hL hb
  have hbp := isPlain_of_isBuiltin hbb
  have hi : L.isTable b m = false := isTable_coerce hbp (coerce?_builtin hbb hb)
  cases s with
  | nil => simp [push_nil, hi]
  | cons t r =>
    rcases top_cases hL hr hs hbp with ⟨ht, hf, -⟩ | ⟨src, x, rfl, hp, hc, hx, -, -⟩
    · rw [push_tableTok hL ht hf, hi]
      have : t ≠ ⟨.named m, [b.text], false⟩ := fun e => by rw [e] at ht; cases ht
      simp [this]
    · rw [push_conv hp]
      by_cases he : src = .named m ∧ x = b.text
      · have h₁ : L.cancelsPlain x m src = true := by
          rw [he.1, he.2]; simp [cancelsPlain, hb]
        have h₂ : L.convTgt? src [x, m] = some src := by
          rw [convTgt?_cons, hc, Option.bind_some, convTgt?_singleton, he.1]
          exact conv?_up hL hb hm
        have h₃ : (⟨src, [x], false⟩ : Tok) = ⟨.named m, [b.text], false⟩ := by rw [he.1, he.2]
        simp [h₁, h₂, h₃]
      · have h₁ : L.cancelsPlain x m src = false := by
          cases h : L.cancelsPlain x m src with
          | false => rfl
          | true =>
            exfalso
            rcases cancelsPlain_true h with ⟨m', b', rfl, hb', rfl, rfl⟩ | ⟨hb', e⟩
            · rw [hb] at hb'
              obtain rfl := Option.some.inj hb'
              exact he ⟨rfl, rfl⟩
            · exact base?_not_builtinName hL hb (e ▸ text_mem_builtinNames (base?_isBuiltin hL hb'))
        have hs₁ : m ≠ "string" := base?_ne hL hb (by simp [builtinNames])
        have hs₂ : m ≠ "date" := base?_ne hL hb (by simp [builtinNames])
        have hs₃ : m ≠ "time" := base?_ne hL hb (by simp [builtinNames])
        rw [if_neg (by simp [h₁]), if_neg (by simp [hs₁]), if_neg (by simp [hs₂, hs₃]),
          if_neg (by simp [hi])]
        simp [tok_ne he]

/-- `datetime` out of a timestamp goes on the stack. -/
theorem push_datetime (hL : L.Sound) {v : ValueType} {s : List Tok} (hr : L.Red s)
    (hs : Schema.Typed L v s .timestamp) :
    L.push .timestamp "datetime" s = ⟨.timestamp, ["datetime"], false⟩ :: s := by
  have hi : L.isTable .timestamp "datetime" = false := isTable_builtin (w := .datetime) rfl rfl
  cases s with
  | nil => simp [push_nil, hi]
  | cons t r =>
    rcases top_cases hL hr hs rfl with ⟨ht, hf, -⟩ | ⟨src, x, rfl, hp, hc, hx, -, -⟩
    · rw [push_tableTok hL ht hf, hi]
      rfl
    · rw [push_conv hp]
      have h₁ : L.cancelsPlain x "datetime" src = false := by
        cases h : L.cancelsPlain x "datetime" src with
        | false => rfl
        | true =>
          exfalso
          rcases cancelsPlain_true h with ⟨m', b', rfl, hb', -, e⟩ | ⟨hb', e⟩
          · exact base?_ne hL hb' (by simp [builtinNames]) e.symm
          · obtain rfl : src = .datetime :=
              text_inj (base?_isBuiltin hL hb') rfl e.symm
            rw [conv?_up hL hb' hx] at hc
            cases hc
      rw [if_neg (by simp [h₁]), if_neg (by simp), if_neg (by simp), if_neg (by simp [hi])]

/-- `date` and `time` out of a timestamp go on the stack. -/
theorem push_date (hL : L.Sound) {d : String} (hd : d = "date" ∨ d = "time") {v : ValueType}
    {s : List Tok} (hr : L.Red s) (hs : Schema.Typed L v s .timestamp) :
    L.push .timestamp d s = ⟨.timestamp, [d], false⟩ :: s := by
  have hb : ∃ w, builtinConv? .timestamp d = some w := by
    rcases hd with rfl | rfl <;> exact ⟨_, rfl⟩
  obtain ⟨w, hw⟩ := hb
  have hi : L.isTable .timestamp d = false := isTable_builtin rfl hw
  have hdn : d ∈ builtinNames := builtinConv?_name hw
  cases s with
  | nil => simp [push_nil, hi]
  | cons t r =>
    rcases top_cases hL hr hs rfl with ⟨ht, hf, -⟩ | ⟨src, x, rfl, hp, hc, hx, -, -⟩
    · rw [push_tableTok hL ht hf, hi]
      rfl
    · rw [push_conv hp]
      have h₁ : L.cancelsPlain x d src = false := by
        cases h : L.cancelsPlain x d src with
        | false => rfl
        | true =>
          exfalso
          rcases cancelsPlain_true h with ⟨m', b', rfl, hb', -, e⟩ | ⟨hb', -⟩
          · exact base?_ne hL hb' hdn e.symm
          · rw [conv?_up hL hb' hx] at hc
            cases hc
      have h₃ : ¬ (x = "datetime" ∧ src = .timestamp) := by
        rintro ⟨rfl, rfl⟩
        rw [conv?_builtin (w := .datetime) rfl rfl] at hc
        cases hc
      have hds : d ≠ "string" := by rcases hd with rfl | rfl <;> decide
      rw [if_neg (by simp [h₁]), if_neg (by simp [hds]), if_neg (by
          intro h
          simp only [Bool.and_eq_true, beq_iff_eq] at h
          exact h₃ ⟨h.1.1.1, h.1.2⟩), if_neg (by simp [hi])]

/-- `date` or `time` after `datetime` out of a timestamp. -/
theorem push_date_merge (hL : L.Sound) {d : String} (hd : d = "date" ∨ d = "time")
    (r : List Tok) :
    L.push .datetime d (⟨.timestamp, ["datetime"], false⟩ :: r) =
      ⟨.timestamp, [d], false⟩ :: r := by
  rw [push_conv rfl]
  have h₁ : L.cancelsPlain "datetime" d .timestamp = false := by
    cases h : L.cancelsPlain "datetime" d .timestamp with
    | false => rfl
    | true =>
      exfalso
      rcases cancelsPlain_true h with ⟨m', b', e, -⟩ | ⟨hb', -⟩
      · cases e
      · rw [base?_builtinName hL (by simp [builtinNames])] at hb'
        cases hb'
  have hds : d ≠ "string" := by rcases hd with rfl | rfl <;> decide
  have h₃ : L.convTgt? .timestamp ["datetime", d] = L.convTgt? .timestamp [d] := by
    rcases hd with rfl | rfl <;> rfl
  rw [if_neg (by simp [h₁]), if_neg (by simp [hds]), if_pos (by
    rcases hd with rfl | rfl <;> simp [h₃])]

/-- `string` after a coercion into a named type is `string` out of the base. -/
theorem push_string_up (hL : L.Sound) {m : String} {b : ValueType} (hb : L.base? m = some b)
    (hbs : b ≠ .string) (hm : m ≠ "some") (r : List Tok) :
    L.push (.named m) "string" (⟨b, [m], false⟩ :: r) = L.push b "string" r := by
  have hbb := base?_isBuiltin hL hb
  have hbp := isPlain_of_isBuiltin hbb
  rw [push_conv hbp]
  have h₁ : L.cancelsPlain m "string" b = false := by
    cases h : L.cancelsPlain m "string" b with
    | false => rfl
    | true =>
      exfalso
      rcases cancelsPlain_true h with ⟨m', b', rfl, -⟩ | ⟨-, e⟩
      · cases hbb
      · exact hbs (text_inj hbb rfl e.symm)
  have h₂ : L.coercionPlain m b = true := by simp [coercionPlain, hb]
  have h₃ : L.convTgt? b [m, "string"] = L.convTgt? b ["string"] := by
    rw [convTgt?_cons, conv?_up hL hb hm, Option.bind_some, convTgt?_singleton,
      convTgt?_singleton, conv?_string rfl (by simp), conv?_string hbp hbs]
  rw [if_neg (by simp [h₁]), if_pos (by simp [h₂, h₃])]

/-- `string` after a coercion to the base is `string` out of the named type. -/
theorem push_string_down (hL : L.Sound) {m : String} {b : ValueType} (hb : L.base? m = some b)
    (hbs : b ≠ .string) (r : List Tok) :
    L.push b "string" (⟨.named m, [b.text], false⟩ :: r) = L.push (.named m) "string" r := by
  have hbb := base?_isBuiltin hL hb
  have hbp := isPlain_of_isBuiltin hbb
  rw [push_conv rfl]
  have h₁ : L.cancelsPlain b.text "string" (.named m) = false := by
    cases h : L.cancelsPlain b.text "string" (.named m) with
    | false => rfl
    | true =>
      exfalso
      rcases cancelsPlain_true h with ⟨m', b', e, hb', -, rfl⟩ | ⟨hb', -⟩
      · exact base?_ne hL hb' (by simp [builtinNames]) rfl
      · rw [base?_builtinName hL (text_mem_builtinNames hbb)] at hb'
        cases hb'
  have h₂ : L.coercionPlain b.text (.named m) = true := by simp [coercionPlain, hb]
  have h₃ : L.convTgt? (.named m) [b.text, "string"] = L.convTgt? (.named m) ["string"] := by
    rw [convTgt?_cons, conv?_down hL hb, Option.bind_some, convTgt?_singleton,
      convTgt?_singleton, conv?_string hbp hbs, conv?_string (u := .named m) rfl (by simp)]
  rw [if_neg (by simp [h₁]), if_pos (by simp [h₂, h₃])]

variable (L) in
/-- A run of tables `ns` out of `u` on the stack `s`: it extends a run of tables on top of
`s`, or starts one. -/
def blockOn (u : ValueType) (ns : List String) : List Tok → List Tok
  | t :: s => if t.table then L.block t.src (t.names ++ ns) s else L.block u ns (t :: s)
  | [] => L.block u ns []

/-- A table extends the run of tables on top of the stack, or starts one. -/
theorem push_table (hL : L.Sound) {u : ValueType} {n : String} {tb : Table}
    (ht : L.table? u n = some tb) {v : ValueType} {s : List Tok} (hr : L.Red s)
    (hs : Schema.Typed L v s u) : L.push u n s = L.blockOn u [n] s := by
  have hi := isTable_of_table? hL ht
  obtain ⟨hv, -⟩ := table?_values hL ht
  obtain ⟨hn₁, hn₂, -⟩ := table?_name hL ht
  cases s with
  | nil => simp [push_nil, hi, blockOn]
  | cons t r =>
    rcases top_cases hL hr hs (isPlain_of_values? hv) with ⟨ht', hf, -⟩ |
        ⟨src, x, rfl, hp, hc, hx, -, -⟩
    · rw [push_tableTok hL ht' hf, hi]
      simp [blockOn, ht']
    · rw [push_conv hp]
      have h₁ : L.cancelsPlain x n src = false := by
        cases h : L.cancelsPlain x n src with
        | false => rfl
        | true =>
          exfalso
          rcases cancelsPlain_true h with ⟨m', b', -, hb', -, rfl⟩ | ⟨hb', rfl⟩
          · simp [base?, hn₂] at hb'
          · exact hn₁ (text_mem_builtinNames (base?_isBuiltin hL hb'))
      have hns : n ≠ "string" := fun e => hn₁ (e ▸ by simp [builtinNames])
      have hnd : n ≠ "date" := fun e => hn₁ (e ▸ by simp [builtinNames])
      have hnt : n ≠ "time" := fun e => hn₁ (e ▸ by simp [builtinNames])
      rw [if_neg (by simp [h₁]), if_neg (by simp [hns]), if_neg (by simp [hnd, hnt]),
        if_pos hi]
      simp [blockOn]

theorem block_append (u : ValueType) (ns : List String) (s : List Tok) :
    L.block u ns s = L.block u ns [] ++ s := by
  unfold block
  split <;> rfl

/-- A field of an optional type goes on the stack, out of a record. -/
theorem push_field (hL : L.Sound) {u w : ValueType} {n : String} (hu : u.isPlain = true)
    (hn : n ≠ "some") (hc : L.conv? u n = some (.optional w)) {v : ValueType} {s : List Tok}
    (hr : L.Red s) (hs : Schema.Typed L v s u) :
    L.push u n s = ⟨u, [n], false⟩ :: s ∧ ∃ r fs, u = .named r ∧ L.fields? r = some fs := by
  rw [conv?_plain hu] at hc
  rcases plainConv?_cases hn hc with ⟨-, -, h⟩ | ⟨-, h⟩ | ⟨-, -, h⟩ | ⟨-, -, -, t, ht, h⟩ |
      ⟨hns, hb, hco, htb, h⟩
  · cases h
  · cases builtinConv?_isBuiltin h
  · rcases coerce?_some h with ⟨m', b', hu', hb', hn', e⟩ | ⟨-, -, e⟩
    · have := base?_isBuiltin hL hb'
      rw [← e] at this
      cases this
    · cases e
  · have := isPlain_of_values? (table?_values hL ht).2
    rw [← h] at this
    cases this
  · obtain ⟨r, fs, rfl, hfs⟩ := field?_some h
    refine ⟨?_, r, fs, rfl, hfs⟩
    have hi : L.isTable (.named r) n = false := by simp [isTable, ValueType.plain, htb]
    cases s with
    | nil => simp [push_nil, hi]
    | cons t r' =>
      rcases top_cases hL hr hs rfl with ⟨ht, hf, -⟩ | ⟨src, x, rfl, hp, hc', hx, -, -⟩
      · rw [push_tableTok hL ht hf, hi]
        rfl
      · rw [push_conv hp]
        have h₁ : L.cancelsPlain x n src = false := by
          cases h : L.cancelsPlain x n src with
          | false => rfl
          | true =>
            exfalso
            rcases cancelsPlain_true h with ⟨m', b', rfl, hb', rfl, -⟩ | ⟨hb', -⟩
            · rw [conv?_down hL hb'] at hc'
              have := base?_isBuiltin hL hb'
              rw [Option.some.inj hc'] at this
              cases this
            · rw [conv?_up hL hb' hx] at hc'
              obtain rfl := ValueType.named.inj (Option.some.inj hc')
              rw [base?_of_fields? hfs] at hb'
              cases hb'
        have h₃ : ¬ (x = "datetime" ∧ src = .timestamp) := by
          rintro ⟨rfl, rfl⟩
          rw [conv?_builtin (w := .datetime) rfl rfl] at hc'
          cases hc'
        rw [if_neg (by simp [h₁]), if_neg (by simp [hns]), if_neg (by
            intro h
            simp only [Bool.and_eq_true, beq_iff_eq] at h
            exact h₃ ⟨h.1.1.1, h.1.2⟩), if_neg (by simp [hi])]

/-! ## Typing -/

private theorem emptySchema_wf : emptySchema.WellFormed := by decide

theorem push_typed {v u w : ValueType} {n : String} {s : List Tok} (hs : Schema.Typed L v s u)
    (hn : L.conv? u n = some w) : Schema.Typed L v (L.push u n s) w :=
  (Schema.push_sound (S := emptySchema) emptySchema_wf n hs hn).1

theorem table?_of_isTable {u : ValueType} {n : String} (h : L.isTable u n = true) :
    ∃ t, L.table? u.plain n = some t := by
  simp only [isTable, Bool.and_eq_true] at h
  exact Option.isSome_iff_exists.mp h.2

theorem tablesFn?_single (hL : L.Sound) {u : ValueType} {n : String} (h : L.isTable u n = true) :
    (L.tablesFn? u.plain [n]).isSome := by
  obtain ⟨t, ht⟩ := table?_of_isTable h
  exact tablesFn?_isSome.mpr ⟨(table?_values hL ht).1, by simp [tablesTgt?, ht]⟩

/-! ## Reduced stacks stay reduced -/

theorem red_block (hL : L.Sound) {u : ValueType} {n : String} {s : List Tok} (hu : u.isPlain = true)
    (hi : L.isTable u n = true) (hr : L.Red s) (hh : ∀ t' ∈ s.head?, t'.table = false) :
    L.Red (L.block u [n] s) := by
  unfold block
  split
  · exact hr
  · rename_i hc
    refine ⟨hr, ?_⟩
    unfold TokRed
    refine ⟨hh, ?_, by simpa using hc⟩
    rw [lifted_of_isPlain hu]
    simpa [plain_of_isPlain hu] using tablesFn?_single hL hi

theorem push_red (hL : L.Sound) {n : String} (hns : n ≠ "some") :
    ∀ {s : List Tok} {v u w : ValueType}, L.Red s → Schema.Typed L v s u → u.isPlain = true →
      L.conv? u n = some w → L.Red (L.push u n s)
  | [], v, u, w, _, _, hu, _ => by
    rw [push_nil]
    split
    · rename_i hi
      exact red_block hL hu hi trivial (by simp)
    · rename_i hi
      refine ⟨trivial, ?_⟩
      unfold TokRed
      exact ⟨n, rfl, hns, by simpa using hi, by rw [push_nil, if_neg hi]⟩
  | t :: r, v, u, w, hr, hs, hu, hn => by
    rcases top_cases hL hr hs hu with ⟨ht, hf, -⟩ | ⟨src, x, rfl, hp, hc, hx, -, -⟩
    · obtain ⟨hr₁, hr₂⟩ := hr
      obtain ⟨hh, -, -⟩ := tokRed_table hr₂ ht
      rw [push_tableTok hL ht hf]
      split
      · rename_i hi
        unfold block
        split
        · exact hr₁
        · rename_i hc
          refine ⟨hr₁, ?_⟩
          unfold TokRed
          refine ⟨hh, ?_, by simpa using hc⟩
          obtain ⟨-, hs₂⟩ := hs
          have hsp := isPlain_of_convTgt? hs₂ hu
          obtain ⟨hv, htg, -, -, -⟩ := tables_end hL hf hs₂
          obtain ⟨tb, htb⟩ := table?_of_isTable hi
          rw [lifted_of_isPlain hsp]
          rw [plain_of_isPlain hsp] at hv htg
          rw [plain_of_isPlain hu] at htg htb
          exact tablesFn?_append_isSome htg hv (by simp [tablesTgt?, htb])
      · rename_i hi
        refine ⟨⟨hr₁, hr₂⟩, ?_⟩
        unfold TokRed
        exact ⟨n, rfl, hns, by simpa using hi, by rw [push_tableTok hL ht hf, if_neg hi]⟩
    · obtain ⟨hr₁, hr₂⟩ := hr
      obtain ⟨hs₁, -⟩ := hs
      rw [push_conv hp]
      split_ifs with h₁ h₂ h₃ h₄
      · exact hr₁
      · simp only [Bool.and_eq_true, beq_iff_eq] at h₂
        have : L.conv? src n = some w := by
          rw [← convTgt?_singleton, ← h₂.2, convTgt?_cons, hc, Option.bind_some,
            convTgt?_singleton, hn]
        exact push_red hL hns hr₁ hs₁ hp this
      · simp only [Bool.and_eq_true, beq_iff_eq, Bool.or_eq_true] at h₃
        obtain ⟨⟨⟨-, hd⟩, rfl⟩, -⟩ := h₃
        refine ⟨hr₁, ?_⟩
        unfold TokRed
        have hb : ∃ w', builtinConv? .timestamp n = some w' := by
          rcases hd with rfl | rfl <;> exact ⟨_, rfl⟩
        obtain ⟨w', hw'⟩ := hb
        exact ⟨n, rfl, hns, isTable_builtin rfl hw', push_date hL hd hr₁ hs₁⟩
      · exact red_block hL hu h₄ ⟨hr₁, hr₂⟩ (by simp)
      · refine ⟨⟨hr₁, hr₂⟩, ?_⟩
        unfold TokRed
        exact ⟨n, rfl, hns, by simpa using h₄, by
          rw [push_conv hp, if_neg h₁, if_neg h₂, if_neg h₃, if_neg h₄]⟩

/-! ## Equivalent stacks -/

theorem sameTok_iff {t t' : Tok} : L.sameTok t t' = true ↔ t.src = t'.src ∧ t.table = t'.table ∧
    (t.names = t'.names ∨ (t.table = true ∧ lifted (L.sameFnPlain t.names t'.names) t.src = true ∧
      L.convTgt? t.src t.names = L.convTgt? t.src t'.names)) := by
  simp [sameTok, and_assoc]

theorem sameFnPlain_iff {ns ns' : List String} {p : ValueType} :
    L.sameFnPlain ns ns' p = true ↔
      (L.tablesFn? p ns).isSome ∧ L.tablesFn? p ns = L.tablesFn? p ns' := by
  simp [sameFnPlain]

theorem sameTok_refl (t : Tok) : L.sameTok t t = true := by simp [sameTok]

theorem sameStk_refl : ∀ s : List Tok, L.sameStk s s = true
  | [] => rfl
  | t :: s => by simp [sameStk, sameTok_refl, sameStk_refl s]

theorem sameStk_cons {t t' : Tok} {s s' : List Tok} :
    L.sameStk (t :: s) (t' :: s') = true ↔ L.sameTok t t' = true ∧ L.sameStk s s' = true := by
  simp [sameStk]

theorem sameTok_symm {t t' : Tok} (h : L.sameTok t t' = true) : L.sameTok t' t = true := by
  rw [sameTok_iff] at h ⊢
  obtain ⟨h₁, h₂, h₃ | ⟨h₄, h₅, h₆⟩⟩ := h
  · exact ⟨h₁.symm, h₂.symm, .inl h₃.symm⟩
  · refine ⟨h₁.symm, h₂.symm, .inr ⟨h₂ ▸ h₄, ?_, h₁ ▸ h₆.symm⟩⟩
    rw [← h₁, lifted_eq_plain h₅]
    rw [lifted_eq_plain h₅, sameFnPlain_iff] at h₅
    exact sameFnPlain_iff.mpr ⟨h₅.2 ▸ h₅.1, h₅.2.symm⟩

theorem sameTok_trans {t t' t'' : Tok} (h : L.sameTok t t' = true) (h' : L.sameTok t' t'' = true) :
    L.sameTok t t'' = true := by
  rw [sameTok_iff] at h h' ⊢
  obtain ⟨h₁, h₂, h₃⟩ := h
  obtain ⟨h₁', h₂', h₃'⟩ := h'
  refine ⟨h₁.trans h₁', h₂.trans h₂', ?_⟩
  rcases h₃ with h₃ | ⟨h₄, h₅, h₆⟩ <;> rcases h₃' with h₃' | ⟨h₄', h₅', h₆'⟩
  · exact .inl (h₃.trans h₃')
  · exact .inr ⟨h₂ ▸ h₄', by rw [h₃, h₁]; exact h₅', by rw [h₃, h₁]; exact h₆'⟩
  · exact .inr ⟨h₄, by rw [← h₃']; exact h₅, by rw [← h₃']; exact h₆⟩
  · refine .inr ⟨h₄, ?_, by rw [h₆, h₁, h₆']⟩
    have e := lifted_eq_plain (Q := L.sameFnPlain t.names t''.names) h₅
    rw [e]
    rw [lifted_eq_plain h₅, sameFnPlain_iff] at h₅
    rw [lifted_eq_plain h₅', sameFnPlain_iff, ← h₁] at h₅'
    exact sameFnPlain_iff.mpr ⟨h₅.1, h₅.2.trans h₅'.2⟩

theorem sameStk_symm : ∀ {s s' : List Tok}, L.sameStk s s' = true → L.sameStk s' s = true
  | [], [], _ => rfl
  | _ :: _, _ :: _, h => by
    rw [sameStk_cons] at h ⊢
    exact ⟨sameTok_symm h.1, sameStk_symm h.2⟩
  | [], _ :: _, h | _ :: _, [], h => by simp [sameStk] at h

theorem sameStk_trans : ∀ {s s' s'' : List Tok}, L.sameStk s s' = true → L.sameStk s' s'' = true →
    L.sameStk s s'' = true
  | [], [], [], _, _ => rfl
  | _ :: _, _ :: _, _ :: _, h, h' => by
    rw [sameStk_cons] at h h' ⊢
    exact ⟨sameTok_trans h.1 h'.1, sameStk_trans h.2 h'.2⟩
  | [], _ :: _, _, h, _ | _ :: _, [], _, h, _ => by simp [sameStk] at h
  | [], [], _ :: _, _, h | _ :: _, _ :: _, [], _, h => by simp [sameStk] at h

theorem block_congr_tail (u : ValueType) (ns : List String) {s s' : List Tok}
    (h : L.sameStk s s' = true) : L.sameStk (L.block u ns s) (L.block u ns s') = true := by
  unfold block
  split
  · exact h
  · exact sameStk_cons.mpr ⟨sameTok_refl _, h⟩

theorem block_congr {u : ValueType} {ns ns' : List String} {s s' : List Tok}
    (hf : lifted (L.sameFnPlain ns ns') u = true) (hc : L.convTgt? u ns = L.convTgt? u ns')
    (h : L.sameStk s s' = true) : L.sameStk (L.block u ns s) (L.block u ns' s') = true := by
  have e : lifted (L.identityPlain ns) u = lifted (L.identityPlain ns') u := by
    rw [lifted_eq_plain hf, lifted_eq_plain hf]
    rw [lifted_eq_plain hf, sameFnPlain_iff] at hf
    simp [identityPlain, hf.2]
  unfold block
  rw [e, hc]
  split
  · exact h
  · exact sameStk_cons.mpr ⟨by rw [sameTok_iff]; exact ⟨rfl, rfl, .inr ⟨rfl, hf, hc⟩⟩, h⟩

/-- `push` takes equivalent stacks to equivalent stacks. -/
theorem push_congr (hL : L.Sound) (n : String) : ∀ {s s' : List Tok} {v u : ValueType},
    Schema.Typed L v s u → Schema.Typed L v s' u → L.sameStk s s' = true →
      L.sameStk (L.push u n s) (L.push u n s') = true
  | [], [], _, _, _, _, _ => sameStk_refl _
  | [], _ :: _, _, _, _, _, h | _ :: _, [], _, _, _, _, h => by simp [sameStk] at h
  | t :: r, t' :: r', v, u, hs, hs', h => by
    rw [sameStk_cons] at h
    obtain ⟨ht, hr⟩ := h
    have ht' := ht
    rw [sameTok_iff] at ht'
    obtain ⟨hsrc, htab, hnm | ⟨htb, hf, hc⟩⟩ := ht'
    · obtain ⟨src, names, tb⟩ := t
      obtain ⟨src', names', tb'⟩ := t'
      simp only at hsrc htab hnm
      subst hsrc htab hnm
      obtain ⟨hs₁, -⟩ := hs
      obtain ⟨hs₁', -⟩ := hs'
      have hrefl : L.sameStk (⟨src, names, tb⟩ :: r) (⟨src, names, tb⟩ :: r') = true :=
        sameStk_cons.mpr ⟨sameTok_refl _, hr⟩
      rw [push, push]
      by_cases h₀ : (tb && L.isTable u n) = true
      · rw [if_pos h₀, if_pos h₀]
        exact block_congr_tail _ _ hr
      · rw [if_neg h₀, if_neg h₀]
        rcases names with _ | ⟨x, _ | ⟨y, ys⟩⟩
        · dsimp only
          split_ifs
          · exact block_congr_tail _ _ hrefl
          · exact sameStk_cons.mpr ⟨sameTok_refl _, hrefl⟩
        · dsimp only
          split_ifs
          · exact hr
          · exact push_congr hL n hs₁ hs₁' hr
          · exact sameStk_cons.mpr ⟨sameTok_refl _, hr⟩
          · exact block_congr_tail _ _ hrefl
          · exact sameStk_cons.mpr ⟨sameTok_refl _, hrefl⟩
        · dsimp only
          split_ifs
          · exact block_congr_tail _ _ hrefl
          · exact sameStk_cons.mpr ⟨sameTok_refl _, hrefl⟩
    · have hf₁ : lifted (fun p => (L.tablesFn? p t.names).isSome) t.src = true := by
        rw [lifted_eq_plain hf]
        rw [lifted_eq_plain hf, sameFnPlain_iff] at hf
        exact hf.1
      have hf₂ : lifted (fun p => (L.tablesFn? p t'.names).isSome) t'.src = true := by
        rw [← hsrc, lifted_eq_plain hf]
        rw [lifted_eq_plain hf, sameFnPlain_iff] at hf
        exact hf.2 ▸ hf.1
      rw [push_tableTok hL htb hf₁, push_tableTok hL (htab ▸ htb) hf₂]
      split
      · rename_i hi
        rw [← hsrc]
        obtain ⟨-, hs₂⟩ := hs
        obtain ⟨hv, htg, -, -, -⟩ := tables_end hL hf₁ hs₂
        obtain ⟨tb, htb'⟩ := table?_of_isTable hi
        refine block_congr ?_ ?_ hr
        · rw [lifted_eq_plain hf, sameFnPlain_iff]
          rw [lifted_eq_plain hf, sameFnPlain_iff] at hf
          exact ⟨tablesFn?_append_isSome htg hv (by simp [tablesTgt?, htb']),
            tablesFn?_append_left hf.2 [n]⟩
        · rw [convTgt?_append, convTgt?_append, hc]
      · exact sameStk_cons.mpr ⟨sameTok_refl _, sameStk_cons.mpr ⟨ht, hr⟩⟩

/-! ## Pushing a path -/

variable (L) in
/-- `push` along the names of a path. -/
def pushAll : ValueType → List String → List Tok → List Tok
  | _, [], s => s
  | u, n :: ns, s => match L.conv? u n with
    | some w => pushAll w ns (L.push u n s)
    | none => s

theorem pushAll_cons {u w : ValueType} {n : String} (ns : List String) (s : List Tok)
    (h : L.conv? u n = some w) : L.pushAll u (n :: ns) s = L.pushAll w ns (L.push u n s) := by
  simp [pushAll, h]

theorem pushAll_single {u w : ValueType} {n : String} (s : List Tok) (h : L.conv? u n = some w) :
    L.pushAll u [n] s = L.push u n s := by
  rw [pushAll_cons _ _ h]
  rfl

theorem pushAll_typed : ∀ {l : List String} {v u o : ValueType} {s : List Tok},
    Schema.Typed L v s u → L.convTgt? u l = some o → Schema.Typed L v (L.pushAll u l s) o
  | [], _, _, _, _, hs, h => by rw [convTgt?_nil, Option.some.injEq] at h; exact h ▸ hs
  | n :: ns, v, u, o, s, hs, h => by
    rw [convTgt?_cons] at h
    cases hc : L.conv? u n with
    | none => simp [hc] at h
    | some w =>
      rw [hc, Option.bind_some] at h
      rw [pushAll_cons _ _ hc]
      exact pushAll_typed (push_typed hs hc) h

theorem pushAll_red (hL : L.Sound) : ∀ {l : List String} {v u o : ValueType} {s : List Tok},
    L.Red s → Schema.Typed L v s u → L.convTgt? u l = some o → o.isPlain = true → "some" ∉ l →
      L.Red (L.pushAll u l s)
  | [], _, _, _, _, hr, _, _, _, _ => hr
  | n :: ns, v, u, o, s, hr, hs, h, ho, hns => by
    have hu := isPlain_of_convTgt? h ho
    rw [convTgt?_cons] at h
    cases hc : L.conv? u n with
    | none => simp [hc] at h
    | some w =>
      rw [hc, Option.bind_some] at h
      rw [pushAll_cons _ _ hc]
      simp only [List.mem_cons, not_or] at hns
      exact pushAll_red hL (push_red hL (Ne.symm hns.1) hr hs hu hc) (push_typed hs hc) h ho hns.2

/-! ## Runs of tables -/

theorem blockOn_of_head {u : ValueType} {ns : List String} {s : List Tok}
    (h : ∀ t ∈ s.head?, t.table = false) : L.blockOn u ns s = L.block u ns s := by
  cases s with
  | nil => rfl
  | cons t r =>
    have : t.table = false := h t rfl
    simp [blockOn, this]

theorem block_identity {u : ValueType} {ns : List String} {s : List Tok} (hu : u.isPlain = true)
    (hs : (L.tablesFn? u ns).isSome) (hi : L.tablesFn? u ns = L.tablesFn? u [])
    (hc : L.convTgt? u ns = some u) : L.block u ns s = s := by
  unfold block
  rw [if_pos]
  simp [lifted_of_isPlain hu, identityPlain, hi, hc, hi ▸ hs]

/-- A table starting a run of tables on a stack whose top is not a run of tables. -/
theorem block_step (hL : L.Sound) {u : ValueType} {n : String} {ns : List String} {tb : Table}
    (hu : u.isPlain = true) (htb : L.table? u n = some tb)
    (hns : (L.tablesFn? tb.target ns).isSome) {s : List Tok}
    (hh : ∀ t ∈ s.head?, t.table = false) :
    L.sameStk (L.blockOn tb.target ns (L.block u [n] s)) (L.block u (n :: ns) s) = true := by
  have hc := conv?_table hL htb
  unfold block
  split
  · rename_i hid
    simp only [Bool.and_eq_true, beq_iff_eq] at hid
    obtain ⟨hid, hct⟩ := hid
    rw [lifted_of_isPlain hu] at hid
    simp only [identityPlain, Bool.and_eq_true, beq_iff_eq] at hid
    rw [convTgt?_singleton, hc] at hct
    obtain rfl : tb.target = u := Option.some.inj hct
    rw [blockOn_of_head hh]
    unfold block
    have e₁ : L.tablesFn? tb.target (n :: ns) = L.tablesFn? tb.target ns :=
      tablesFn?_append_left hid.2 ns
    have e₂ : L.convTgt? tb.target (n :: ns) = L.convTgt? tb.target ns := by
      rw [convTgt?_cons, hc]
      rfl
    have e₃ : L.identityPlain (n :: ns) tb.target = L.identityPlain ns tb.target := by
      simp [identityPlain, e₁]
    rw [lifted_of_isPlain hu, lifted_of_isPlain hu, e₃, e₂]
    split
    · exact sameStk_refl _
    · rename_i hne
      refine sameStk_cons.mpr ⟨?_, sameStk_refl _⟩
      rw [sameTok_iff]
      refine ⟨rfl, rfl, .inr ⟨rfl, ?_, e₂.symm⟩⟩
      rw [lifted_of_isPlain hu, sameFnPlain_iff]
      exact ⟨hns, e₁.symm⟩
  · simp only [blockOn, if_true, List.singleton_append]
    exact sameStk_refl _

/-- Pushing a path of tables is putting the run of tables on the stack. -/
theorem pushAll_tables (hL : L.Sound) : ∀ (ns : List String) {v u : ValueType} {s : List Tok},
    L.Red s → Schema.Typed L v s u → (L.tablesFn? u ns).isSome →
      L.sameStk (L.pushAll u ns s) (L.blockOn u ns s) = true
  | [], v, u, s, hr, hs, hf => by
    have hu := isPlain_of_values? (tablesFn?_isSome.mp hf).1
    cases s with
    | nil => simp [pushAll, blockOn, block_identity hu hf rfl rfl, sameStk]
    | cons t r =>
      cases ht : t.table with
      | true =>
        obtain ⟨-, -, hc⟩ := tokRed_table hr.2 ht
        have : L.block t.src (t.names ++ []) r = t :: r := by
          unfold block
          rw [List.append_nil, if_neg (by simp [hc])]
          obtain ⟨src, names, tb⟩ := t
          simp only at ht
          rw [ht]
        simp only [pushAll, blockOn, ht, if_true, this]
        exact sameStk_refl _
      | false =>
        simp only [pushAll, blockOn, ht, Bool.false_eq_true, if_false,
          block_identity hu hf rfl rfl]
        exact sameStk_refl _
  | n :: ns, v, u, s, hr, hs, hf => by
    obtain ⟨hv, htg⟩ := tablesFn?_isSome.mp hf
    have hu := isPlain_of_values? hv
    simp only [tablesTgt?] at htg
    cases htb : L.table? u n with
    | none => simp [htb] at htg
    | some tb =>
      rw [htb, Option.bind_some] at htg
      have hc := conv?_table hL htb
      have hw := (table?_values hL htb).2
      have hns : (L.tablesFn? tb.target ns).isSome := tablesFn?_isSome.mpr ⟨hw, htg⟩
      have hn : n ≠ "some" := (table?_name hL htb).2.2
      rw [pushAll_cons _ _ hc, push_table hL htb hr hs]
      have hR : L.Red (L.blockOn u [n] s) := push_table hL htb hr hs ▸ push_red hL hn hr hs hu hc
      have hT : Schema.Typed L v (L.blockOn u [n] s) tb.target :=
        push_table hL htb hr hs ▸ push_typed hs hc
      refine sameStk_trans (pushAll_tables hL ns hR hT hns) ?_
      clear hR hT
      cases s with
      | cons t r =>
        cases ht : t.table with
        | true =>
          obtain ⟨hh, hf', -⟩ := tokRed_table hr.2 ht
          obtain ⟨-, hs₂⟩ := hs
          have hsp := isPlain_of_convTgt? hs₂ hu
          obtain ⟨hv', htg', -, -, -⟩ := tables_end hL hf' hs₂
          rw [plain_of_isPlain hsp] at hv' htg'
          rw [plain_of_isPlain hu] at htg'
          have hct : L.convTgt? t.src (t.names ++ [n]) = some tb.target := by
            rw [convTgt?_append, hs₂, Option.bind_some, convTgt?_singleton, hc]
          rw [show L.blockOn u [n] (t :: r) = L.block t.src (t.names ++ [n]) r by
              simp [blockOn, ht],
            show L.blockOn u (n :: ns) (t :: r) = L.block t.src (t.names ++ n :: ns) r by
              simp [blockOn, ht]]
          by_cases hid : (lifted (L.identityPlain (t.names ++ [n])) t.src &&
              L.convTgt? t.src (t.names ++ [n]) == some t.src) = true
          · have hblk : L.block t.src (t.names ++ [n]) r = r := by
              unfold block
              rw [if_pos hid]
            rw [hblk]
            simp only [Bool.and_eq_true, beq_iff_eq] at hid
            obtain ⟨hid, hct'⟩ := hid
            rw [lifted_of_isPlain hsp] at hid
            simp only [identityPlain, Bool.and_eq_true, beq_iff_eq] at hid
            have e : tb.target = t.src := Option.some.inj (hct.symm.trans hct')
            rw [e, blockOn_of_head hh]
            rw [e] at hns
            refine block_congr ?_ ?_ (sameStk_refl _)
            · rw [lifted_of_isPlain hsp, sameFnPlain_iff]
              refine ⟨hns, ?_⟩
              rw [show t.names ++ n :: ns = (t.names ++ [n]) ++ ns by simp,
                tablesFn?_append_left hid.2 ns]
              rfl
            · rw [show t.names ++ n :: ns = (t.names ++ [n]) ++ ns by simp,
                convTgt?_append (l := t.names ++ [n]), hct', Option.bind_some]
          · have hblk : L.block t.src (t.names ++ [n]) r = ⟨t.src, t.names ++ [n], true⟩ :: r := by
              unfold block
              rw [if_neg hid]
            rw [hblk]
            simp only [blockOn, if_true, List.append_assoc, List.singleton_append]
            exact sameStk_refl _
        | false =>
          have hh : ∀ t' ∈ (t :: r).head?, t'.table = false := by simp [ht]
          rw [blockOn_of_head (ns := [n]) hh, blockOn_of_head (ns := n :: ns) hh]
          exact block_step hL hu htb hns hh
      | nil =>
        rw [blockOn_of_head (s := []) (ns := [n]) (by simp),
          blockOn_of_head (s := []) (ns := n :: ns) (by simp)]
        exact block_step hL hu htb hns (by simp)

theorem blockOn_congr (hL : L.Sound) {v u : ValueType} {x y : List String} {s : List Tok}
    (hr : L.Red s) (hs : Schema.Typed L v s u) (hx : (L.tablesFn? u x).isSome)
    (hxy : L.tablesFn? u x = L.tablesFn? u y) (hc : L.convTgt? u x = L.convTgt? u y) :
    L.sameStk (L.blockOn u x s) (L.blockOn u y s) = true := by
  have hu := isPlain_of_values? (tablesFn?_isSome.mp hx).1
  have hplain : L.sameStk (L.block u x s) (L.block u y s) = true :=
    block_congr (by rw [lifted_of_isPlain hu, sameFnPlain_iff]; exact ⟨hx, hxy⟩) hc
      (sameStk_refl _)
  cases s with
  | cons t r =>
    cases ht : t.table with
    | true =>
      obtain ⟨-, hf', -⟩ := tokRed_table hr.2 ht
      obtain ⟨-, hs₂⟩ := hs
      have hsp := isPlain_of_convTgt? hs₂ hu
      obtain ⟨hv', htg', -, -, -⟩ := tables_end hL hf' hs₂
      rw [plain_of_isPlain hsp] at hv' htg'
      rw [plain_of_isPlain hu] at htg'
      simp only [blockOn, ht, if_true]
      refine block_congr ?_ ?_ (sameStk_refl _)
      · rw [lifted_of_isPlain hsp, sameFnPlain_iff]
        exact ⟨tablesFn?_append_isSome htg' hv' (tablesFn?_isSome.mp hx).2,
          tablesFn?_append_right hL htg' hxy hx⟩
      · rw [convTgt?_append, convTgt?_append, hs₂, Option.bind_some, Option.bind_some, hc]
    | false =>
      have hh : ∀ t' ∈ (t :: r).head?, t'.table = false := by simp [ht]
      rw [blockOn_of_head hh, blockOn_of_head hh]
      exact hplain
  | nil =>
    rw [blockOn_of_head (by simp), blockOn_of_head (by simp)]
    exact hplain

@[simp] theorem pushAll_nil (u : ValueType) (s : List Tok) : L.pushAll u [] s = s := rfl

theorem text_ne_some {b : ValueType} (hb : b.isBuiltin = true) : b.text ≠ "some" := fun e => by
  have := text_mem_builtinNames hb
  rw [e] at this
  simp [builtinNames] at this

theorem head_eq {s : List Tok} {t : Tok} (h : s.head? = some t) : ∃ r, s = t :: r := by
  cases s with
  | nil => simp at h
  | cons t' r => exact ⟨r, by simp only [List.head?_cons, Option.some.injEq] at h; rw [h]⟩

/-- The conversion on top of a reduced stack is put there by `push`. -/
theorem push_top {src : ValueType} {m : String} {r : List Tok}
    (hr : L.Red (⟨src, [m], false⟩ :: r)) :
    L.push src m r = ⟨src, [m], false⟩ :: r ∧ m ≠ "some" := by
  obtain ⟨x', hx', hxs, -, hpush⟩ := tokRed_conv hr.2 rfl
  simp only [List.cons.injEq, and_true] at hx'
  subst hx'
  exact ⟨hpush, hxs⟩

/-- An equation of `Basic` at a plain type, pushed onto a reduced stack, gives equivalent
stacks. -/
theorem pushAll_basic (hL : L.Sound) {v u o : ValueType} {s : List Tok} {x y : List String}
    (hr : L.Red s) (hs : Schema.Typed L v s u) (hu : u.isPlain = true) (h : L.Basic u x y)
    (hx : L.convTgt? u x = some o) (hy : L.convTgt? u y = some o) (hsx : "some" ∉ x) :
    L.sameStk (L.pushAll u x s) (L.pushAll u y s) = true := by
  cases h with
  | @coerceBack m b hb =>
    have hm : m ≠ "some" := fun e => hsx (by simp [e])
    have hbb := base?_isBuiltin hL hb
    have hd := conv?_down hL hb
    have hup := conv?_up hL hb hm
    rw [pushAll_cons _ _ hd, pushAll_single _ hup, pushAll_nil]
    by_cases hh : s.head? = some ⟨b, [m], false⟩
    · obtain ⟨r, rfl⟩ := head_eq hh
      rw [push_down hL hb hr hs, if_pos hh]
      simp only [List.tail_cons]
      rw [(push_top hr).1]
      exact sameStk_refl _
    · have e₁ : L.push (.named m) b.text s = ⟨.named m, [b.text], false⟩ :: s := by
        rw [push_down hL hb hr hs, if_neg hh]
      have hred : L.Red (⟨.named m, [b.text], false⟩ :: s) :=
        e₁ ▸ push_red hL (text_ne_some hbb) hr hs hu hd
      have htyp : Schema.Typed L v (⟨.named m, [b.text], false⟩ :: s) b := e₁ ▸ push_typed hs hd
      rw [e₁, push_up hL hb hm hred htyp]
      simp only [List.head?_cons, if_true, List.tail_cons]
      exact sameStk_refl _
  | @coerceThere m _ hb =>
    have hm : m ≠ "some" := fun e => hsx (by simp [e])
    have hbb := base?_isBuiltin hL hb
    have hd := conv?_down hL hb
    have hup := conv?_up hL hb hm
    rw [pushAll_cons _ _ hup, pushAll_single _ hd, pushAll_nil]
    by_cases hh : s.head? = some ⟨.named m, [u.text], false⟩
    · obtain ⟨r, rfl⟩ := head_eq hh
      rw [push_up hL hb hm hr hs, if_pos hh]
      simp only [List.tail_cons]
      rw [(push_top hr).1]
      exact sameStk_refl _
    · have e₁ : L.push u m s = ⟨u, [m], false⟩ :: s := by rw [push_up hL hb hm hr hs, if_neg hh]
      have hred : L.Red (⟨u, [m], false⟩ :: s) := e₁ ▸ push_red hL hm hr hs hu hup
      have htyp : Schema.Typed L v (⟨u, [m], false⟩ :: s) (.named m) := e₁ ▸ push_typed hs hup
      rw [e₁, push_down hL hb hred htyp]
      simp only [List.head?_cons, if_true, List.tail_cons]
      exact sameStk_refl _
  | tables h₁ h₂ =>
    have e₁ := pushAll_tables hL x hr hs h₁
    have e₂ := pushAll_tables hL y hr hs (h₂ ▸ h₁)
    exact sameStk_trans e₁ (sameStk_trans (blockOn_congr hL hr hs h₁ h₂ (hx.trans hy.symm))
      (sameStk_symm e₂))
  | some => exact absurd (by simp) hsx
  | date =>
    rw [pushAll_cons _ _ (conv?_builtin (w := .datetime) rfl rfl),
      pushAll_single _ (conv?_builtin (w := .date) rfl rfl),
      pushAll_single _ (conv?_builtin (w := .date) rfl rfl), push_datetime hL hr hs,
      push_date_merge hL (.inl rfl), push_date hL (.inl rfl) hr hs]
    exact sameStk_refl _
  | time =>
    rw [pushAll_cons _ _ (conv?_builtin (w := .datetime) rfl rfl),
      pushAll_single _ (conv?_builtin (w := .time) rfl rfl),
      pushAll_single _ (conv?_builtin (w := .time) rfl rfl), push_datetime hL hr hs,
      push_date_merge hL (.inr rfl), push_date hL (.inr rfl) hr hs]
    exact sameStk_refl _
  | @stringBack m b hb =>
    have hbb := base?_isBuiltin hL hb
    have hbp := isPlain_of_isBuiltin hbb
    have hd := conv?_down hL hb
    have hbs : b ≠ .string := by
      rintro rfl
      rw [convTgt?_cons, hd, Option.bind_some, convTgt?_singleton] at hx
      simp [conv?, plainConv?] at hx
    rw [pushAll_cons _ _ hd, pushAll_single _ (conv?_string hbp hbs),
      pushAll_single _ (conv?_string (u := .named m) rfl (by simp))]
    by_cases hh : s.head? = some ⟨b, [m], false⟩
    · obtain ⟨r, rfl⟩ := head_eq hh
      rw [push_down hL hb hr hs, if_pos hh]
      simp only [List.tail_cons]
      rw [push_string_up hL hb hbs (push_top hr).2]
      exact sameStk_refl _
    · rw [push_down hL hb hr hs, if_neg hh, push_string_down hL hb hbs]
      exact sameStk_refl _
  | @stringThere m _ hb =>
    have hm : m ≠ "some" := fun e => hsx (by simp [e])
    have hbb := base?_isBuiltin hL hb
    have hbp := isPlain_of_isBuiltin hbb
    have hup := conv?_up hL hb hm
    have hbs : u ≠ .string := by
      rintro rfl
      rw [convTgt?_singleton] at hy
      simp [conv?, plainConv?] at hy
    rw [pushAll_cons _ _ hup, pushAll_single _ (conv?_string (u := .named m) rfl (by simp)),
      pushAll_single _ (conv?_string hbp hbs)]
    by_cases hh : s.head? = some ⟨.named m, [u.text], false⟩
    · obtain ⟨r, rfl⟩ := head_eq hh
      rw [push_up hL hb hm hr hs, if_pos hh]
      simp only [List.tail_cons]
      rw [push_string_down hL hb hbs]
      exact sameStk_refl _
    · rw [push_up hL hb hm hr hs, if_neg hh, push_string_up hL hb hbs hm]
      exact sameStk_refl _
  | lift hp _ => exact absurd hu (by simp [ValueType.isPlain])

/-! ## Optional types -/

/-- The step out of the optional type of the source of `t`: its lift. -/
def Tok.lift (t : Tok) : Tok := { t with src := .optional t.src }

variable (L) in
/-- A stack that pushes at optional types do not reach: the stack below the steps out
of optional types. -/
def Wall (s₀ : List Tok) : Prop :=
  ∀ u n, L.push (.optional u) n s₀ = L.push (.optional u) n [] ++ s₀

theorem wall_nil : L.Wall [] := fun _ _ => (List.append_nil _).symm

/-- A field of a record stops the pushes at optional types. -/
theorem wall_record (hL : L.Sound) {r : String} {fs : List (String × ValueType)}
    (hr : L.fields? r = some fs) (f : String) (s : List Tok) :
    L.Wall (⟨.named r, [f], false⟩ :: s) := by
  intro u n
  obtain ⟨h₁, h₂⟩ := record_tests hL hr f n
  rw [push_conv rfl, push_nil, if_neg (by simp [h₁]), if_neg (by simp [h₂]),
    if_neg (by simp)]
  split
  · rw [block_append]
  · rfl

theorem block_lift {p q : ValueType} {ns : List String} (hp : p.isPlain = true)
    (hc : L.convTgt? p ns = some q) (hc' : L.convTgt? (.optional p) ns = some (.optional q))
    (s s₀ : List Tok) :
    L.block (.optional p) ns (s.map Tok.lift ++ s₀) = (L.block p ns s).map Tok.lift ++ s₀ := by
  unfold block
  rw [lifted_optional hp, lifted_of_isPlain hp, hc, hc']
  have e : (some (ValueType.optional q) == some (ValueType.optional p)) = (some q == some p) := by
    by_cases hq : q = p
    · simp [hq]
    · have h₁ : (some (ValueType.optional q) == some (ValueType.optional p)) = false := by
        simpa using fun e => hq (ValueType.optional.inj e)
      have h₂ : (some q == some p) = false := by simpa using hq
      rw [h₁, h₂]
  rw [e]
  by_cases hc₂ : (L.identityPlain ns p && some q == some p) = true
  · rw [if_pos hc₂, if_pos hc₂]
  · rw [if_neg hc₂, if_neg hc₂]
    rfl

theorem conv?_optional_beq {p w : ValueType} {n : String} (hp : p.isPlain = true)
    (hw : w.isPlain = true) :
    (L.convTgt? (.optional p) [n] == some (.optional w)) = (L.convTgt? p [n] == some w) := by
  rw [convTgt?_singleton, convTgt?_singleton]
  by_cases h : L.conv? p n = some w
  · rw [h, conv?_lift hp hw h]
    simp
  · have h' : L.conv? (.optional p) n ≠ some (.optional w) := fun e => h (conv?_of_lift e).2.2
    simp [h, h']

/-- Pushing at optional types onto lifted steps is lifting the push at plain types. -/
theorem push_lift (hL : L.Sound) {s₀ : List Tok} (hW : L.Wall s₀) (n : String) :
    ∀ {s : List Tok} {b u w : ValueType}, u.isPlain = true → w.isPlain = true →
      L.conv? u n = some w → Schema.Typed L b s u →
      Schema.Typed L (.optional b) (s.map Tok.lift) (.optional u) →
      L.push (.optional u) n (s.map Tok.lift ++ s₀) = (L.push u n s).map Tok.lift ++ s₀
  | [], b, u, w, hu, hw, hc, _, _ => by
    simp only [List.map_nil, List.nil_append]
    rw [hW u n, push_nil, push_nil, isTable_optional hu]
    have h₁ : L.convTgt? u [n] = some w := by rw [convTgt?_singleton, hc]
    have h₂ : L.convTgt? (.optional u) [n] = some (.optional w) := by
      rw [convTgt?_singleton, conv?_lift hu hw hc]
    split
    · have := block_lift hu h₁ h₂ [] []
      simp only [List.map_nil, List.append_nil] at this
      rw [this]
    · rfl
  | ⟨src, names, tb⟩ :: r, b, u, w, hu, hw, hc, ⟨hs₁, hs₂⟩, ⟨hs₁', hs₂'⟩ => by
    change L.convTgt? src names = some u at hs₂
    change L.convTgt? (.optional src) names = some (.optional u) at hs₂'
    change Schema.Typed L (.optional b) (r.map Tok.lift) (.optional src) at hs₁'
    have hsp := isPlain_of_convTgt? hs₂ hu
    have hcw : L.convTgt? src (names ++ [n]) = some w := by rw [convTgt?_snoc hs₂, hc]
    have hcw' : L.convTgt? (.optional src) (names ++ [n]) = some (.optional w) := by
      rw [convTgt?_snoc hs₂', conv?_lift hu hw hc]
    have hn₁ : L.convTgt? u [n] = some w := by rw [convTgt?_singleton, hc]
    have hn₂ : L.convTgt? (.optional u) [n] = some (.optional w) := by
      rw [convTgt?_singleton, conv?_lift hu hw hc]
    have hcons : (⟨.optional src, names, tb⟩ :: (r.map Tok.lift ++ s₀) : List Tok) =
        (⟨src, names, tb⟩ :: r).map Tok.lift ++ s₀ := rfl
    change L.push (.optional u) n (⟨.optional src, names, tb⟩ :: (r.map Tok.lift ++ s₀)) = _
    rw [push, push]
    dsimp only
    rw [isTable_optional hu]
    by_cases h₀ : (tb && L.isTable u n) = true
    · rw [if_pos h₀, if_pos h₀, block_lift hsp hcw hcw']
    · rw [if_neg h₀, if_neg h₀]
      rcases names with _ | ⟨x, _ | ⟨y, ys⟩⟩
      · dsimp only
        split_ifs
        · rw [hcons, block_lift hu hn₁ hn₂]
        · rfl
      · dsimp only
        have hx₁ : L.convTgt? src [x, n] = some w := by simpa using hcw
        have hx₂ : L.convTgt? (.optional src) [x, n] = some (.optional w) := by simpa using hcw'
        have e₁ : (lifted (L.cancelsPlain x n) (.optional src) &&
            L.convTgt? (.optional src) [x, n] == some (.optional src)) =
            (lifted (L.cancelsPlain x n) src && L.convTgt? src [x, n] == some src) := by
          rw [lifted_optional hsp, lifted_of_isPlain hsp, hx₁, hx₂]
          by_cases hws : w = src
          · simp [hws]
          · have h₁ : (some (ValueType.optional w) == some (ValueType.optional src)) = false := by
              simpa using fun e => hws (ValueType.optional.inj e)
            have h₂ : (some w == some src) = false := by simpa using hws
            rw [h₁, h₂]
        have e₀ : (L.convTgt? (.optional src) [x, n] == L.convTgt? (.optional src) [n]) =
            (L.convTgt? src [x, n] == L.convTgt? src [n]) := by
          rw [hx₁, hx₂]
          have := conv?_optional_beq (L := L) (n := n) hsp hw
          rw [Bool.beq_comm, this, Bool.beq_comm]
        have e₂ : (n == "string" && lifted (L.coercionPlain x) (.optional src) &&
            L.convTgt? (.optional src) [x, n] == L.convTgt? (.optional src) [n]) =
            (n == "string" && lifted (L.coercionPlain x) src &&
              L.convTgt? src [x, n] == L.convTgt? src [n]) := by
          rw [lifted_optional hsp, lifted_of_isPlain hsp, e₀]
        have e₃ : (x == "datetime" && (n == "date" || n == "time") &&
            lifted (· == ValueType.timestamp) (.optional src) &&
            L.convTgt? (.optional src) [x, n] == L.convTgt? (.optional src) [n]) =
            (x == "datetime" && (n == "date" || n == "time") &&
              lifted (· == ValueType.timestamp) src &&
              L.convTgt? src [x, n] == L.convTgt? src [n]) := by
          rw [lifted_optional hsp, lifted_of_isPlain hsp, e₀]
        rw [e₁, e₂, e₃]
        split_ifs with c₁ c₂
        · rfl
        · simp only [Bool.and_eq_true, beq_iff_eq] at c₂
          have hcn : L.conv? src n = some w := by
            rw [← convTgt?_singleton, ← c₂.2, hx₁]
          exact push_lift hL hW n hsp hw hcn hs₁ hs₁'
        · rfl
        · rw [hcons, block_lift hu hn₁ hn₂]
        · rfl
      · dsimp only
        split_ifs
        · rw [hcons, block_lift hu hn₁ hn₂]
        · rfl

theorem pushAll_lift (hL : L.Sound) {s₀ : List Tok} (hW : L.Wall s₀) :
    ∀ {l : List String} {s : List Tok} {b u q : ValueType}, u.isPlain = true →
      L.convTgt? (.optional u) l = some (.optional q) → Schema.Typed L b s u →
      Schema.Typed L (.optional b) (s.map Tok.lift) (.optional u) →
      L.pushAll (.optional u) l (s.map Tok.lift ++ s₀) = (L.pushAll u l s).map Tok.lift ++ s₀
  | [], _, _, _, _, _, _, _, _ => rfl
  | n :: ns, s, b, u, q, hu, h, hs, hs' => by
    rw [convTgt?_cons] at h
    cases hc : L.conv? (.optional u) n with
    | none => simp [hc] at h
    | some y =>
      rw [hc, Option.bind_some] at h
      obtain ⟨-, w, hw, hwp, rfl⟩ := conv?_optional hc
      have hcw : L.conv? u n = some w := by rw [conv?_plain hu, hw]
      rw [pushAll_cons _ _ hc, pushAll_cons _ _ hcw, push_lift hL hW n hu hwp hcw hs hs']
      have ht := push_typed hs hcw
      have ht' : Schema.Typed L (.optional b) ((L.push u n s).map Tok.lift) (.optional w) := by
        have := push_typed (n := n) (s := s.map Tok.lift ++ []) (by simpa using hs') hc
        rwa [push_lift hL wall_nil n hu hwp hcw hs hs', List.append_nil] at this
      exact pushAll_lift hL hW hwp h ht ht'

theorem typed_plain : ∀ {s : List Tok} {b u : ValueType}, Schema.Typed L b s u → u.isPlain = true →
    ∀ t ∈ s, t.src.isPlain = true
  | [], _, _, _, _ => by simp
  | t :: r, b, u, ⟨h₁, h₂⟩, hu => by
    have hsp := isPlain_of_convTgt? h₂ hu
    intro t' ht'
    rcases List.mem_cons.mp ht' with rfl | ht'
    · exact hsp
    · exact typed_plain h₁ hsp t' ht'

theorem sameStk_lift (hL : L.Sound) (s₀ : List Tok) :
    ∀ {a c : List Tok} {b u : ValueType}, Schema.Typed L b a u → Schema.Typed L b c u →
      u.isPlain = true → L.sameStk a c = true →
      L.sameStk (a.map Tok.lift ++ s₀) (c.map Tok.lift ++ s₀) = true
  | [], [], _, _, _, _, _, _ => sameStk_refl _
  | [], _ :: _, _, _, _, _, _, h | _ :: _, [], _, _, _, _, _, h => by simp [sameStk] at h
  | t :: a, t' :: c, b, u, ⟨ha₁, ha₂⟩, ⟨hc₁, hc₂⟩, hu, h => by
    rw [sameStk_cons] at h
    obtain ⟨ht, hac⟩ := h
    have hsp := isPlain_of_convTgt? ha₂ hu
    have ht₀ := ht
    rw [sameTok_iff] at ht₀
    obtain ⟨hsrc, htab, hn⟩ := ht₀
    simp only [List.map_cons, List.cons_append]
    refine sameStk_cons.mpr ⟨?_, sameStk_lift hL s₀ ha₁ (hsrc ▸ hc₁) hsp hac⟩
    rw [sameTok_iff]
    refine ⟨by simp [Tok.lift, hsrc], by simp [Tok.lift, htab], ?_⟩
    rcases hn with hn | ⟨htb, hf, hcv⟩
    · exact .inl (by simp [Tok.lift, hn])
    · refine .inr ⟨htb, ?_, ?_⟩
      · simpa [Tok.lift, lifted_optional hsp, lifted_of_isPlain hsp] using hf
      · rw [lifted_of_isPlain hsp, sameFnPlain_iff] at hf
        obtain ⟨hv, hq⟩ := tablesFn?_isSome.mp hf.1
        obtain ⟨q, hq⟩ := Option.isSome_iff_exists.mp hq
        have hq' : L.tablesTgt? t.src t'.names = some q := by
          rw [← tablesTgt?_of_tablesFn? hf.2 hf.1, hq]
        simp only [Tok.lift]
        rw [(convTgt?_tables hL hv hq).2, (convTgt?_tables hL hv hq').2]

theorem push_typed_lift (hL : L.Sound) {s : List Tok} {b u w : ValueType} {n : String}
    (hu : u.isPlain = true) (hw : w.isPlain = true) (hc : L.conv? u n = some w)
    (hs : Schema.Typed L b s u)
    (hs' : Schema.Typed L (.optional b) (s.map Tok.lift) (.optional u)) :
    Schema.Typed L (.optional b) ((L.push u n s).map Tok.lift) (.optional w) := by
  have := push_typed (n := n) (s := s.map Tok.lift ++ []) (by simpa using hs') (conv?_lift hu hw hc)
  rwa [push_lift hL wall_nil n hu hw hc hs hs', List.append_nil] at this

/-! ## Normal forms of paths -/

variable (L) in
/-- What the normal forms of paths satisfy: the stack is typed; at a plain type it is
reduced; at an optional type it is a lifted reduced stack on a wall. -/
structure Good (v : ValueType) (st : NF) : Prop where
  typed : Schema.Typed L v st.stk st.cur
  plain : st.moved = true → st.cur.isPlain = true
  red : st.cur.isPlain = true → L.Red st.stk
  lift : ∀ u, st.cur = .optional u → u.isPlain = true → ∃ s₁ s₀ b,
    st.stk = s₁.map Tok.lift ++ s₀ ∧ L.Wall s₀ ∧ L.Red s₁ ∧ Schema.Typed L b s₁ u ∧
      Schema.Typed L (.optional b) (s₁.map Tok.lift) (.optional u)

theorem good_init (v : ValueType) : L.Good v ⟨v, false, []⟩ where
  typed := rfl
  plain h := by cases h
  red _ := trivial
  lift u _ _ := ⟨[], [], u, rfl, wall_nil, trivial, rfl, rfl⟩

theorem nfStep_actual {st : NF} {n : String} {y : ValueType} (hy : L.conv? st.actual n = some y) :
    (L.nfStep st n).actual = y := by
  obtain ⟨c, m, s⟩ := st
  unfold nfStep
  split
  · rename_i hn
    subst hn
    obtain ⟨hp, rfl⟩ := conv?_some hy
    cases m
    · rfl
    · simp [NF.actual, ValueType.isPlain] at hp
  · rename_i hn
    cases m with
    | true =>
      change L.conv? (.optional c) n = some y at hy
      obtain ⟨hp, w, hw, -, rfl⟩ := conv?_optional hy
      have : L.conv? c n = some w := by rw [conv?_plain hp, hw]
      simp only [this]
      rfl
    | false =>
      change L.conv? c n = some y at hy
      simp only [hy]
      rfl

theorem nfStep_good (hL : L.Sound) {v : ValueType} {st : NF} (h : L.Good v st) {n : String}
    {y : ValueType} (hy : L.conv? st.actual n = some y) : L.Good v (L.nfStep st n) := by
  obtain ⟨c, m, s⟩ := st
  by_cases hn : n = "some"
  · subst hn
    obtain ⟨hp, -⟩ := conv?_some hy
    cases m with
    | true => simp [NF.actual, ValueType.isPlain] at hp
    | false =>
      change c.isPlain = true at hp
      have e : L.nfStep ⟨c, false, s⟩ "some" = ⟨c, true, s⟩ := by simp [nfStep]
      rw [e]
      refine ⟨h.typed, fun _ => hp, h.red, ?_⟩
      intro u e _
      change c = .optional u at e
      subst e
      cases hp
  · cases hcn : L.conv? c n with
    | none =>
      have e : L.nfStep ⟨c, m, s⟩ n = ⟨c, m, s⟩ := by simp [nfStep, hn, hcn]
      rw [e]
      exact h
    | some w =>
      have e : L.nfStep ⟨c, m, s⟩ n = ⟨w, m, L.push c n s⟩ := by simp [nfStep, hn, hcn]
      rw [e]
      have ht : Schema.Typed L v s c := h.typed
      cases m with
      | true =>
        change L.conv? (.optional c) n = some y at hy
        obtain ⟨hc, w', hw', hwp, rfl⟩ := conv?_optional hy
        have hww : w = w' := by
          rw [conv?_plain hc, hw'] at hcn
          exact (Option.some.inj hcn).symm
        subst hww
        refine ⟨push_typed ht hcn, fun _ => hwp, fun _ => push_red hL hn (h.red hc) ht hc hcn, ?_⟩
        intro u e _
        change w = .optional u at e
        subst e
        cases hwp
      | false =>
        by_cases hc : c.isPlain = true
        · have hr : L.Red s := h.red hc
          refine ⟨push_typed ht hcn, (fun e => by cases e), fun _ => push_red hL hn hr ht hc hcn,
            ?_⟩
          intro u e _
          change w = .optional u at e
          subst e
          obtain ⟨hp, r, fs, rfl, hfs⟩ := push_field hL hc hn hcn hr ht
          refine ⟨[], ⟨.named r, [n], false⟩ :: s, u, ?_, wall_record hL hfs n s, trivial, rfl, rfl⟩
          simpa using hp
        · obtain ⟨c', rfl⟩ : ∃ c', c = .optional c' := by
            cases c <;> simp_all [ValueType.isPlain]
          obtain ⟨hc', w', hw', hwp, rfl⟩ := conv?_optional hcn
          have hcn' : L.conv? c' n = some w' := by rw [conv?_plain hc', hw']
          obtain ⟨s₁, s₀, b, hs₁, hW, hr₁, ht₁, ht₁'⟩ := h.lift c' rfl hc'
          change s = s₁.map Tok.lift ++ s₀ at hs₁
          subst hs₁
          refine ⟨push_typed ht hcn, (fun e => by cases e), fun hw => ?_, ?_⟩
          · simp [ValueType.isPlain] at hw
          · intro u e _
            change ValueType.optional w' = .optional u at e
            obtain rfl : w' = u := ValueType.optional.inj e
            exact ⟨L.push c' n s₁, s₀, b, push_lift hL hW n hc' hwp hcn' ht₁ ht₁', hW,
              push_red hL hn hr₁ ht₁ hc' hcn', push_typed ht₁ hcn',
              push_typed_lift hL hc' hwp hcn' ht₁ ht₁'⟩

private theorem emptySchema_wf' : emptySchema.WellFormed := emptySchema_wf

theorem nf_tgt {v y : ValueType} {l : List String} (h : L.convTgt? v l = some y) :
    L.convTgt? v l = some (L.nf v l).actual :=
  (Schema.nf_sound (S := emptySchema) (L := L) emptySchema_wf' l h).tgt

theorem nf_append (v : ValueType) (l m : List String) :
    L.nf v (l ++ m) = m.foldl L.nfStep (L.nf v l) := by
  simp [nf, List.foldl_append]

theorem nf_good (hL : L.Sound) {v : ValueType} : ∀ {l : List String},
    (L.convTgt? v l).isSome → L.Good v (L.nf v l) := by
  have key : ∀ (l acc : List String), (L.convTgt? v (acc ++ l)).isSome → L.Good v (L.nf v acc) →
      L.Good v (L.nf v (acc ++ l)) := by
    intro l
    induction l with
    | nil => intro acc _ h; simpa using h
    | cons n ns ih =>
      intro acc hl h
      have hl' : (L.convTgt? v ((acc ++ [n]) ++ ns)).isSome := by simpa using hl
      have hn : (L.convTgt? v (acc ++ [n])).isSome := by
        rw [convTgt?_append] at hl'
        cases hc : L.convTgt? v (acc ++ [n]) <;> simp_all
      obtain ⟨x, hx⟩ := Option.isSome_iff_exists.mp hn
      have ha : (L.convTgt? v acc).isSome := by
        rw [convTgt?_append] at hx
        cases hc : L.convTgt? v acc <;> simp_all
      obtain ⟨a, ha⟩ := Option.isSome_iff_exists.mp ha
      have hy : L.conv? (L.nf v acc).actual n = some x := by
        rw [convTgt?_snoc (nf_tgt ha)] at hx
        exact hx
      have h' : L.Good v (L.nf v (acc ++ [n])) := by
        rw [nf_append]
        exact nfStep_good hL h hy
      have := ih (acc ++ [n]) hl' h'
      simpa using this
  intro l hl
  simpa using key l [] (by simpa using hl) (good_init v)

/-! ## Equivalent normal forms -/

variable (L) in
/-- Two normal forms are the same: the same type, the same flag, equivalent stacks. -/
def Same (st st' : NF) : Prop :=
  st.cur = st'.cur ∧ st.moved = st'.moved ∧ L.sameStk st.stk st'.stk = true

theorem same_refl (st : NF) : L.Same st st := ⟨rfl, rfl, sameStk_refl _⟩

theorem same_symm {st st' : NF} (h : L.Same st st') : L.Same st' st :=
  ⟨h.1.symm, h.2.1.symm, sameStk_symm h.2.2⟩

theorem same_trans {st st' st'' : NF} (h : L.Same st st') (h' : L.Same st' st'') :
    L.Same st st'' :=
  ⟨h.1.trans h'.1, h.2.1.trans h'.2.1, sameStk_trans h.2.2 h'.2.2⟩

theorem same_actual {st st' : NF} (h : L.Same st st') : st.actual = st'.actual := by
  unfold NF.actual
  rw [h.1, h.2.1]

theorem nfStep_congr (hL : L.Sound) {v : ValueType} {st st' : NF} (h : L.Same st st')
    (hs : Schema.Typed L v st.stk st.cur) (hs' : Schema.Typed L v st'.stk st'.cur) (n : String) :
    L.Same (L.nfStep st n) (L.nfStep st' n) := by
  obtain ⟨c, m, s⟩ := st
  obtain ⟨c', m', s'⟩ := st'
  obtain ⟨hc, hm, hss⟩ := h
  simp only at hc hm hss hs hs'
  subst hc hm
  unfold nfStep
  split
  · exact ⟨rfl, rfl, hss⟩
  · dsimp only
    cases hcn : L.conv? c n with
    | none => exact ⟨rfl, rfl, hss⟩
    | some w => exact ⟨rfl, rfl, push_congr hL n hs hs' hss⟩

theorem foldl_congr (hL : L.Sound) {v : ValueType} : ∀ (l : List String) {st st' : NF},
    L.Good v st → L.Good v st' → L.Same st st' → (L.convTgt? st.actual l).isSome →
      L.Same (l.foldl L.nfStep st) (l.foldl L.nfStep st')
  | [], _, _, _, _, h, _ => h
  | n :: ns, st, st', hg, hg', h, hl => by
    rw [convTgt?_cons] at hl
    cases hc : L.conv? st.actual n with
    | none => simp [hc] at hl
    | some y =>
      rw [hc, Option.bind_some] at hl
      have hc' : L.conv? st'.actual n = some y := by rw [← same_actual h, hc]
      exact foldl_congr hL ns (nfStep_good hL hg hc) (nfStep_good hL hg' hc')
        (nfStep_congr hL h hg.typed hg'.typed n) (by rw [nfStep_actual hc]; exact hl)

/-! ## The equations, in context -/

theorem foldl_nfStep : ∀ {l : List String} {c o : ValueType} {m : Bool} {s : List Tok},
    "some" ∉ l → L.convTgt? c l = some o → l.foldl L.nfStep ⟨c, m, s⟩ = ⟨o, m, L.pushAll c l s⟩
  | [], c, o, m, s, _, h => by
    rw [convTgt?_nil, Option.some.injEq] at h
    subst h
    rfl
  | n :: ns, c, o, m, s, hs, h => by
    simp only [List.mem_cons, not_or] at hs
    rw [convTgt?_cons] at h
    cases hc : L.conv? c n with
    | none => simp [hc] at h
    | some w =>
      rw [hc, Option.bind_some] at h
      have : L.nfStep ⟨c, m, s⟩ n = ⟨w, m, L.push c n s⟩ := by
        simp [nfStep, Ne.symm hs.1, hc]
      rw [List.foldl_cons, this, foldl_nfStep hs.2 h, pushAll_cons _ _ hc]

/-- At an optional type, the equations are the lifts of the equations at its base. -/
theorem basic_optional (hL : L.Sound) {p : ValueType} {x y : List String}
    (h : L.Basic (.optional p) x y) : p.isPlain = true ∧ L.Basic p x y := by
  cases h with
  | coerceThere hb => exact absurd (base?_isBuiltin hL hb) (by simp [ValueType.isBuiltin])
  | tables h₁ _ => simp [tablesFn?_isSome, values?] at h₁
  | some hv => simp [ValueType.isPlain] at hv
  | stringThere hb => exact absurd (base?_isBuiltin hL hb) (by simp [ValueType.isBuiltin])
  | lift hp h' => exact ⟨hp, h'⟩

theorem tables_noSome (hL : L.Sound) : ∀ {u : ValueType} {l : List String},
    (L.tablesTgt? u l).isSome → "some" ∉ l
  | _, [], _ => by simp
  | u, n :: ns, h => by
    simp only [tablesTgt?] at h
    cases ht : L.table? u n with
    | none => simp [ht] at h
    | some t =>
      rw [ht, Option.bind_some] at h
      simp only [List.mem_cons, not_or]
      exact ⟨Ne.symm (table?_name hL ht).2.2, tables_noSome hL h⟩

/-- An equation at a plain type moves `some`, or has no `some` on either side. -/
theorem basic_cases (hL : L.Sound) {u o : ValueType} {x y : List String} (hu : u.isPlain = true)
    (h : L.Basic u x y) (hx : L.convTgt? u x = some o) (hy : L.convTgt? u y = some o) :
    (∃ n w, x = ["some", n] ∧ y = [n, "some"] ∧ n ≠ "some" ∧ L.plainConv? u n = some w ∧
      w.isPlain = true) ∨ ("some" ∉ x ∧ "some" ∉ y) := by
  have hopt : ∀ {p : ValueType} {l : List String} {r : ValueType},
      L.convTgt? p ("some" :: l) = some r → p.isPlain = true → r.isPlain = false := by
    intro p l r h hp
    rw [convTgt?_cons, conv?_plain hp] at h
    simp only [plainConv?, if_true, Option.bind_some] at h
    obtain ⟨q, rfl, -⟩ := convTgt?_of_optional h
    rfl
  cases h with
  | @coerceBack m b hb =>
    refine .inr ⟨?_, by simp⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
    refine ⟨Ne.symm (text_ne_some (base?_isBuiltin hL hb)), fun e => ?_⟩
    subst e
    rw [convTgt?_nil, Option.some.injEq] at hy
    subst hy
    rw [convTgt?_cons, conv?_down hL hb, Option.bind_some, convTgt?_singleton,
      conv?_plain (isPlain_of_isBuiltin (base?_isBuiltin hL hb))] at hx
    simp [plainConv?] at hx
  | @coerceThere m _ hb =>
    refine .inr ⟨?_, by simp⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
    refine ⟨fun e => ?_, Ne.symm (text_ne_some (base?_isBuiltin hL hb))⟩
    subst e
    rw [convTgt?_nil, Option.some.injEq] at hy
    subst hy
    exact absurd (hopt hx hu) (by simp [hu])
  | tables h₁ h₂ =>
    exact .inr ⟨tables_noSome hL (tablesFn?_isSome.mp h₁).2,
      tables_noSome hL (tablesFn?_isSome.mp (h₂ ▸ h₁)).2⟩
  | some hv hn hw hwp => exact .inl ⟨_, _, rfl, rfl, hn, hw, hwp⟩
  | date => exact .inr ⟨by decide, by decide⟩
  | time => exact .inr ⟨by decide, by decide⟩
  | @stringBack m b hb =>
    refine .inr ⟨?_, by decide⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
    exact ⟨Ne.symm (text_ne_some (base?_isBuiltin hL hb)), by decide⟩
  | @stringThere m _ hb =>
    refine .inr ⟨?_, by decide⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or]
    refine ⟨fun e => ?_, by decide⟩
    subst e
    have h₁ := hopt hx hu
    rw [convTgt?_singleton, conv?_plain hu] at hy
    unfold plainConv? at hy
    rw [if_neg (by decide), if_pos rfl] at hy
    split at hy
    · cases hy
    · obtain rfl := Option.some.inj hy
      cases h₁
  | lift hp _ => exact absurd hu (by simp [ValueType.isPlain])

/-- An equation of `Basic`, after the normal form of a path, gives the same normal form. -/
theorem nf_basic (hL : L.Sound) {v : ValueType} {st : NF} (hg : L.Good v st)
    {x y : List String} {o : ValueType} (h : L.Basic st.actual x y)
    (hx : L.convTgt? st.actual x = some o) (hy : L.convTgt? st.actual y = some o) :
    L.Same (x.foldl L.nfStep st) (y.foldl L.nfStep st) := by
  obtain ⟨c, m, s⟩ := st
  cases m with
  | true =>
    have hc : c.isPlain = true := hg.plain rfl
    change L.Basic (.optional c) x y at h
    change L.convTgt? (.optional c) x = some o at hx
    change L.convTgt? (.optional c) y = some o at hy
    obtain ⟨-, h'⟩ := basic_optional hL h
    obtain ⟨q, rfl, hq, hsx, -⟩ := convTgt?_of_optional hx
    obtain ⟨q', e, hq', hsy, -⟩ := convTgt?_of_optional hy
    obtain rfl := ValueType.optional.inj e
    rw [foldl_nfStep hsx hq, foldl_nfStep hsy hq']
    exact ⟨rfl, rfl, pushAll_basic hL (hg.red hc) hg.typed hc h' hq hq' hsx⟩
  | false =>
    change L.Basic c x y at h
    change L.convTgt? c x = some o at hx
    change L.convTgt? c y = some o at hy
    by_cases hc : c.isPlain = true
    · rcases basic_cases hL hc h hx hy with ⟨n, w, rfl, rfl, hn, hw, -⟩ | ⟨hsx, hsy⟩
      · have hcn : L.conv? c n = some w := by rw [conv?_plain hc, hw]
        have e₁ : List.foldl L.nfStep ⟨c, false, s⟩ ["some", n] = ⟨w, true, L.push c n s⟩ := by
          simp [nfStep, hn, hcn]
        have e₂ : List.foldl L.nfStep ⟨c, false, s⟩ [n, "some"] = ⟨w, true, L.push c n s⟩ := by
          simp [nfStep, hn, hcn]
        rw [e₁, e₂]
        exact same_refl _
      · rw [foldl_nfStep hsx hx, foldl_nfStep hsy hy]
        exact ⟨rfl, rfl, pushAll_basic hL (hg.red hc) hg.typed hc h hx hy hsx⟩
    · obtain ⟨c', rfl⟩ : ∃ c', c = .optional c' := by
        cases c <;> simp_all [ValueType.isPlain]
      obtain ⟨hc', h'⟩ := basic_optional hL h
      obtain ⟨q, rfl, hq, hsx, hpl⟩ := convTgt?_of_optional hx
      obtain ⟨q', e, hq', hsy, -⟩ := convTgt?_of_optional hy
      obtain rfl := ValueType.optional.inj e
      have hqp : q.isPlain = true := by
        cases x with
        | nil =>
          rw [convTgt?_nil, Option.some.injEq] at hq
          exact hq ▸ hc'
        | cons _ _ => exact (hpl (by simp)).2
      obtain ⟨s₁, s₀, b, rfl, hW, hr₁, ht₁, ht₁'⟩ := hg.lift c' rfl hc'
      rw [foldl_nfStep hsx hx, foldl_nfStep hsy hy, pushAll_lift hL hW hc' hx ht₁ ht₁',
        pushAll_lift hL hW hc' hy ht₁ ht₁']
      exact ⟨rfl, rfl, sameStk_lift hL s₀ (pushAll_typed ht₁ hq) (pushAll_typed ht₁ hq') hqp
        (pushAll_basic hL hr₁ ht₁ hc' h' hq hq' hsx)⟩

end TypeList

/-! ## Completeness -/

namespace Schema

open CategoryTheory TypeList

variable {S : Schema} {L : TypeList}

theorem value_of_vtgt? {v : ValueType} {l : List String} {o : Ob}
    (h : S.vtgt? L (.value v) l = some o) : ∃ u, o = .value u ∧ L.convTgt? v l = some u := by
  rw [vtgt?_value_conv] at h
  obtain ⟨u, hu, rfl⟩ := Option.map_eq_some_iff.mp h
  exact ⟨u, rfl, hu⟩

/-- An equation of `Basic` in context keeps the normal form. -/
theorem same_of_basic_context (hL : L.Sound) {v u o : ValueType} {A B B' C : List String}
    (hA : L.convTgt? v A = some u) (hb : L.Basic u B B') (hB : L.convTgt? u B = some o)
    (hB' : L.convTgt? u B' = some o) (hC : (L.convTgt? o C).isSome) :
    L.Same (L.nf v (A ++ (B ++ C))) (L.nf v (A ++ (B' ++ C))) := by
  have hgood := nf_good hL (v := v) (l := A) (by rw [hA]; rfl)
  have hact : (L.nf v A).actual = u := Option.some.inj ((nf_tgt hA).symm.trans hA)
  rw [← hact] at hb hB hB'
  have hs := nf_basic hL hgood hb hB hB'
  have t₁ : L.convTgt? v (A ++ B) = some o := by
    rw [convTgt?_append, hA, Option.bind_some, ← hB, hact]
  have t₂ : L.convTgt? v (A ++ B') = some o := by
    rw [convTgt?_append, hA, Option.bind_some, ← hB', hact]
  have g₁ := nf_good hL (v := v) (l := A ++ B) (by rw [t₁]; rfl)
  have g₂ := nf_good hL (v := v) (l := A ++ B') (by rw [t₂]; rfl)
  have a₁ : (L.nf v (A ++ B)).actual = o := Option.some.inj ((nf_tgt t₁).symm.trans t₁)
  rw [nf_append] at g₁ g₂ a₁
  rw [nf_append, nf_append, List.foldl_append, List.foldl_append]
  exact foldl_congr hL C g₁ g₂ hs (by rw [a₁]; exact hC)

/-- One step of the congruence generated by the equations, out of a value type, keeps the
normal form. -/
theorem same_of_compClosure (hL : L.Sound) {v : ValueType} {b : S.VObj L}
    {p q : Quiver.Path (vval S L v) b}
    (h : Quotient.CompClosure (S.vrel L) (s := vval S L v) (t := b) p q) :
    L.Same (L.nf v (vnames p)) (L.nf v (vnames q)) := by
  obtain ⟨f, m₁, m₂, g, hr⟩ := h
  simp only [vnames_paths_comp]
  obtain ⟨u, ha, hfu⟩ := value_of_vtgt? (vtgt?_vnames f)
  have h₁ := vtgt?_vnames m₁
  have h₂ := vtgt?_vnames m₂
  have h₃ := vtgt?_vnames g
  rw [ha] at h₁ h₂
  obtain ⟨o, hb, hmo₁⟩ := value_of_vtgt? h₁
  obtain ⟨o', hb', hmo₂⟩ := value_of_vtgt? h₂
  rw [hb] at hb'
  cases hb'
  rw [hb] at h₃
  obtain ⟨o₂, -, hgo⟩ := value_of_vtgt? h₃
  rcases hr with ⟨eq, -, hsrc, -, -⟩ | ⟨u', hu', hbasic⟩
  · rw [ha] at hsrc
    cases hsrc
  · rw [ha] at hu'
    cases hu'
    exact same_of_basic_context hL hfu hbasic hmo₁ hmo₂ (by rw [hgo]; rfl)

/-- Paths out of a value type that present the same morphism have the same normal form. -/
theorem same_of_vmor (hL : L.Sound) {v : ValueType} {b : S.VObj L}
    {p q : Quiver.Path (vval S L v) b} (h : vmor p = vmor q) :
    L.Same (L.nf v (vnames p)) (L.nf v (vnames q)) := by
  have h' := (Quotient.functor_homRel_eq_compClosure_eqvGen (r := S.vrel L)
    (X := vval S L v) (Y := b) p q).mp h
  clear h
  induction h' with
  | rel _ _ h => exact same_of_compClosure hL h
  | refl => exact same_refl _
  | symm _ _ _ ih => exact same_symm ih
  | trans _ _ _ _ _ ih₁ ih₂ => exact same_trans ih₁ ih₂

/-- Equal paths of conversions have the same normal form. -/
theorem convEq_complete (hL : L.Sound) {v : ValueType} {l l' : List String}
    (h : S.VPathEq L (vval S L v) l l') : L.convEq v l l' = true := by
  obtain ⟨b, p, q, rfl, rfl, hpq⟩ := h
  have hs := same_of_vmor hL hpq
  obtain ⟨u, hb, hp⟩ := value_of_vtgt? (vtgt?_vnames p)
  obtain ⟨u', hb', hq⟩ := value_of_vtgt? (vtgt?_vnames q)
  rw [hb] at hb'
  cases hb'
  simp only [convEq, Bool.and_eq_true, beq_iff_eq]
  exact ⟨⟨⟨by rw [hp]; rfl, hp.trans hq.symm⟩, hs.2.1⟩, hs.2.2⟩

/-- For a sound list of value types, two paths of conversions present the same morphism
exactly when they have the same normal form. -/
theorem convEq_iff (hS : S.WellFormed) (hL : L.Sound) {v : ValueType} {l l' : List String} :
    L.convEq v l l' = true ↔ S.VPathEq L (vval S L v) l l' :=
  ⟨convEq_sound hS, convEq_complete hL⟩

/-- Out of a value type, `pathEqV` decides path equality. -/
theorem pathEqV_value_iff (hS : S.WellFormed) (hL : L.Sound) {v : ValueType}
    {l l' : List String} : S.pathEqV L (.value v) l l' = true ↔ S.VPathEq L (vval S L v) l l' := by
  refine ⟨pathEqV_sound hS (vval S L v), fun h => ?_⟩
  have hc := convEq_complete hL h
  have he : ∀ m : List String, S.entityLen (.value v) m = 0 := fun m => by
    cases m <;> rfl
  have h₀ : S.pathEq (.value v) [] [] = true := by
    simp [pathEq, pathEqFree, tgt?]
  simp only [pathEqV, he, List.take_zero, List.drop_zero, Bool.or_eq_true]
  right
  simp [tgt?, h₀, hc]

/-! ## Paths out of entity types -/

theorem entityLen_value (v : ValueType) (l : List String) : S.entityLen (.value v) l = 0 := by
  cases l <;> rfl

theorem entityLen_cons {e : String} {n : String} {ns : List String} {o : Ob}
    (h : S.step? (.entity e) n = some o) :
    S.entityLen (.entity e) (n :: ns) = S.entityLen o ns + 1 := by
  simp [entityLen, h]

theorem entityLen_le : ∀ (o : Ob) (l : List String), S.entityLen o l ≤ l.length
  | .value v, l => by rw [entityLen_value]; exact Nat.zero_le _
  | .entity _, [] => Nat.zero_le _
  | .entity e, n :: ns => by
    cases hs : S.step? (.entity e) n with
    | none => simp [entityLen, hs]
    | some o =>
      rw [entityLen_cons hs, List.length_cons]
      exact Nat.succ_le_succ (entityLen_le o ns)

/-- A path of generators and conversions between entity types is a path of `S`. -/
theorem tgt?_of_vtgt?_entity : ∀ {o : Ob} {l : List String} {e : String},
    S.vtgt? L o l = some (.entity e) → S.tgt? o l = some (.entity e)
  | _, [], _, h => h
  | .value v, n :: ns, e, h => by
    obtain ⟨u, hu, -⟩ := value_of_vtgt? h
    cases hu
  | .entity e₀, n :: ns, e, h => by
    rw [vtgt?_cons] at h
    rw [tgt?_cons]
    cases hs : S.step? (.entity e₀) n with
    | none => simp [vstep?, hs] at h
    | some o' =>
      have h' : S.vtgt? L o' ns = some (.entity e) := by simpa [vstep?, hs] using h
      rw [Option.bind_some]
      exact tgt?_of_vtgt?_entity h'

theorem entityLen_append_tgt? : ∀ {o x : Ob} {M : List String} (X : List String),
    S.tgt? o M = some x → S.entityLen o (M ++ X) = M.length + S.entityLen x X
  | o, x, [], X, h => by
    rw [tgt?_nil, Option.some.injEq] at h
    subst h
    simp
  | .value v, x, n :: M, X, h => by simp [step?] at h
  | .entity e, x, n :: M, X, h => by
    rw [tgt?_cons] at h
    cases hs : S.step? (.entity e) n with
    | none => simp [hs] at h
    | some o' =>
      rw [hs, Option.bind_some] at h
      rw [List.cons_append, entityLen_cons hs, entityLen_append_tgt? X h, List.length_cons]
      omega

theorem entityLen_append_value : ∀ {o : Ob} {F : List String} {u : ValueType} (X : List String),
    S.vtgt? L o F = some (.value u) → S.entityLen o (F ++ X) = S.entityLen o F
  | .value v, F, u, X, _ => by rw [entityLen_value, entityLen_value]
  | .entity e, [], u, X, h => by simp at h
  | .entity e, n :: F, u, X, h => by
    rw [vtgt?_cons] at h
    cases hs : S.step? (.entity e) n with
    | none => simp [vstep?, hs] at h
    | some o' =>
      have h' : S.vtgt? L o' F = some (.value u) := by simpa [vstep?, hs] using h
      rw [List.cons_append, entityLen_cons hs, entityLen_cons hs, entityLen_append_value X h']

/-- A path of generators and conversions is a path of `S` up to the first value type,
then conversions; a path that reaches no value type is a path of `S`. -/
theorem vtgt?_split : ∀ {o r : Ob} {l : List String}, S.vtgt? L o l = some r →
    ∃ x, S.tgt? o (l.take (S.entityLen o l)) = some x ∧
      S.vtgt? L x (l.drop (S.entityLen o l)) = some r ∧
      ∀ e, x = .entity e → l.drop (S.entityLen o l) = []
  | o, r, [], h => by
    have : S.entityLen o [] = 0 := by cases o <;> rfl
    rw [this]
    exact ⟨o, rfl, h, fun _ _ => rfl⟩
  | .value v, r, n :: ns, h => by
    rw [entityLen_value]
    exact ⟨.value v, rfl, h, fun _ e => by cases e⟩
  | .entity e, r, n :: ns, h => by
    rw [vtgt?_cons] at h
    cases hs : S.step? (.entity e) n with
    | none => simp [vstep?, hs] at h
    | some o' =>
      have h' : S.vtgt? L o' ns = some r := by simpa [vstep?, hs] using h
      obtain ⟨x, h₁, h₂, h₃⟩ := vtgt?_split h'
      rw [entityLen_cons hs, List.take_succ_cons, List.drop_succ_cons, tgt?_cons, hs,
        Option.bind_some]
      exact ⟨x, h₁, h₂, h₃⟩

variable (S L) in
/-- The parts in `S` of two paths rewrite into each other, and after a value type their
conversions have the same normal form. -/
def SplitEq (o : Ob) (l l' : List String) : Prop :=
  Relation.ReflTransGen (S.Rewrite o) (l.take (S.entityLen o l)) (l'.take (S.entityLen o l')) ∧
    ∀ v, S.tgt? o (l.take (S.entityLen o l)) = some (.value v) →
      L.Same (L.nf v (l.drop (S.entityLen o l))) (L.nf v (l'.drop (S.entityLen o l')))

theorem rewrite_tgt? (hS : S.WellFormed) {o : Ob} {w w' : List String} (h : S.Rewrite o w w') :
    S.tgt? o w = S.tgt? o w' := by
  obtain ⟨q, hq, s, hs, u, v, hu, rfl, rfl⟩ := h
  obtain ⟨oq, hl, hr⟩ := hS.eqn_parallel q hq
  have hs' : S.tgt? (.entity q.src) s.1 = S.tgt? (.entity q.src) s.2 := by
    simp only [Equation.sides, List.mem_cons, List.not_mem_nil, or_false] at hs
    rcases hs with rfl | rfl
    · rw [hl, hr]
    · rw [hl, hr]
  rw [tgt?_append, tgt?_append, tgt?_append, tgt?_append, hu, Option.bind_some,
    Option.bind_some, hs']

theorem rewrites_tgt? (hS : S.WellFormed) {o : Ob} {w w' : List String}
    (h : Relation.ReflTransGen (S.Rewrite o) w w') : S.tgt? o w = S.tgt? o w' := by
  induction h with
  | refl => rfl
  | tail _ h ih => exact ih.trans (rewrite_tgt? hS h)

theorem splitEq_refl (o : Ob) (l : List String) : S.SplitEq L o l l :=
  ⟨.refl, fun _ _ => same_refl _⟩

theorem splitEq_symm (hS : S.WellFormed) {o : Ob} {l l' : List String} (h : S.SplitEq L o l l') :
    S.SplitEq L o l' l :=
  ⟨Relation.ReflTransGen.symmetric (fun _ _ h => Rewrite.symm h) h.1,
    fun v hv => same_symm (h.2 v ((rewrites_tgt? hS h.1).trans hv))⟩

theorem splitEq_trans (hS : S.WellFormed) {o : Ob} {l l' l'' : List String}
    (h : S.SplitEq L o l l') (h' : S.SplitEq L o l' l'') : S.SplitEq L o l l'' :=
  ⟨h.1.trans h'.1, fun v hv =>
    same_trans (h.2 v hv) (h'.2 v ((rewrites_tgt? hS h.1).symm.trans hv))⟩

/-- One step of the congruence generated by the equations rewrites the part in `S` or
keeps the normal form of the conversions. -/
theorem splitEq_of_compClosure (hS : S.WellFormed) (hL : L.Sound) {a b : S.VObj L}
    {p q : Quiver.Path a b} (h : Quotient.CompClosure (S.vrel L) (s := a) (t := b) p q) :
    S.SplitEq L a.1 (vnames p) (vnames q) := by
  obtain ⟨f, m₁, m₂, g, hr⟩ := h
  simp only [vnames_paths_comp]
  have hf := vtgt?_vnames f
  have h₁ := vtgt?_vnames m₁
  have h₂ := vtgt?_vnames m₂
  have h₃ := vtgt?_vnames g
  rcases hr with ⟨eq, heq, hsrc, hm₁, hm₂⟩ | ⟨u, hu, hbasic⟩
  · rw [hsrc] at hf
    have hft := tgt?_of_vtgt?_entity hf
    obtain ⟨oq, hl, hr'⟩ := hS.eqn_parallel eq heq
    unfold SplitEq
    rw [hm₁, hm₂, entityLen_append_tgt? _ hft, entityLen_append_tgt? _ hl,
      entityLen_append_tgt? _ hft, entityLen_append_tgt? _ hr', List.take_length_add_append,
      List.take_length_add_append, List.take_length_add_append, List.take_length_add_append,
      List.drop_length_add_append, List.drop_length_add_append, List.drop_length_add_append,
      List.drop_length_add_append]
    refine ⟨.single ⟨eq, heq, (eq.lhs, eq.rhs), by simp [Equation.sides], vnames f,
      (vnames g).take (S.entityLen oq (vnames g)), hft, by simp, by simp⟩, fun _ _ => same_refl _⟩
  · rw [hu] at hf h₁ h₂
    obtain ⟨o, hb, hmo₁⟩ := value_of_vtgt? h₁
    obtain ⟨o', hb', hmo₂⟩ := value_of_vtgt? h₂
    rw [hb] at hb'
    cases hb'
    rw [hb] at h₃
    obtain ⟨o₂, -, hgo⟩ := value_of_vtgt? h₃
    unfold SplitEq
    have hk := entityLen_le (S := S) a.1 (vnames f)
    rw [entityLen_append_value _ hf, entityLen_append_value _ hf,
      List.take_append_of_le_length hk, List.take_append_of_le_length hk,
      List.drop_append_of_le_length hk, List.drop_append_of_le_length hk]
    refine ⟨.refl, fun v₀ hv₀ => ?_⟩
    obtain ⟨x, hx₁, hx₂, -⟩ := vtgt?_split hf
    obtain rfl := Option.some.inj (hx₁.symm.trans hv₀)
    obtain ⟨u', hu', hA⟩ := value_of_vtgt? hx₂
    cases hu'
    exact same_of_basic_context hL hA hbasic hmo₁ hmo₂ (by rw [hgo]; rfl)

theorem splitEq_of_vmor (hS : S.WellFormed) (hL : L.Sound) {a b : S.VObj L}
    {p q : Quiver.Path a b} (h : vmor p = vmor q) : S.SplitEq L a.1 (vnames p) (vnames q) := by
  have h' := (Quotient.functor_homRel_eq_compClosure_eqvGen (r := S.vrel L) (X := a) (Y := b)
    p q).mp h
  clear h
  induction h' with
  | rel _ _ h => exact splitEq_of_compClosure hS hL h
  | refl => exact splitEq_refl _ _
  | symm _ _ _ ih => exact splitEq_symm hS ih
  | trans _ _ _ _ _ ih₁ ih₂ => exact splitEq_trans hS ih₁ ih₂

/-- Lists of names that rewrite into each other name equal paths of `S`. -/
theorem pathEq_of_rewrites (hS : S.WellFormed) {a : S.Obj} {w w' : List String}
    (h : Relation.ReflTransGen (S.Rewrite a.1) w w') {o : Ob} (hw : S.tgt? a.1 w = some o) :
    S.PathEq a w w' := by
  obtain ⟨b, p, -, hp⟩ := exists_path hS a w hw
  suffices ∀ w'', Relation.ReflTransGen (S.Rewrite a.1) w w'' →
      ∃ p' : Quiver.Path a b, names p' = w'' ∧ mor p = mor p' by
    obtain ⟨p', hp', hm⟩ := this w' h
    exact ⟨b, p, p', hp, hp', hm⟩
  intro w'' h''
  induction h'' with
  | refl => exact ⟨p, hp, rfl⟩
  | tail _ hr ih =>
    obtain ⟨p', hp', hm⟩ := ih
    obtain ⟨p'', hp'', hm'⟩ := Rewrite.exists_mor_eq hS (p := p') (by rw [hp']; exact hr)
    exact ⟨p'', hp'', hm.trans hm'⟩

theorem convEq_of_same {v o : ValueType} {l l' : List String} (hs : L.Same (L.nf v l) (L.nf v l'))
    (hl : L.convTgt? v l = some o) (hl' : L.convTgt? v l' = some o) : L.convEq v l l' = true := by
  simp only [convEq, Bool.and_eq_true, beq_iff_eq]
  exact ⟨⟨⟨by rw [hl]; rfl, hl.trans hl'.symm⟩, hs.2.1⟩, hs.2.2⟩

/-- `pathEqV` decides path equality with conversions whenever `pathEq` decides path
equality in `S`. -/
theorem pathEqV_complete (hS : S.WellFormed) (hL : L.Sound)
    (hP : ∀ (a : S.Obj) (l l' : List String), S.PathEq a l l' → S.pathEq a.1 l l' = true)
    {a : S.VObj L} {l l' : List String} (h : S.VPathEq L a l l') : S.pathEqV L a.1 l l' = true := by
  obtain ⟨b, p, q, rfl, rfl, hpq⟩ := h
  obtain ⟨hrw, hsame⟩ := splitEq_of_vmor hS hL hpq
  obtain ⟨x, hx₁, hx₂, hx₃⟩ := vtgt?_split (vtgt?_vnames p)
  obtain ⟨x', hx₁', hx₂', hx₃'⟩ := vtgt?_split (vtgt?_vnames q)
  obtain rfl : x = x' := Option.some.inj (hx₁.symm.trans ((rewrites_tgt? hS hrw).trans hx₁'))
  have hpe := hP ⟨a.1, a.2⟩ _ _ (pathEq_of_rewrites hS (a := ⟨a.1, a.2⟩) hrw hx₁)
  unfold pathEqV
  cases x with
  | value v =>
    rw [hx₁]
    obtain ⟨ob, hob, hd⟩ := value_of_vtgt? hx₂
    obtain ⟨ob', hob', hd'⟩ := value_of_vtgt? hx₂'
    rw [hob] at hob'
    cases hob'
    simp only [hpe, Bool.true_and, Bool.or_eq_true]
    exact .inr (convEq_of_same (hsame v hx₁) hd hd')
  | entity e =>
    have e₁ : vnames p = (vnames p).take (S.entityLen a.1 (vnames p)) := by
      conv_lhs => rw [← List.take_append_drop (S.entityLen a.1 (vnames p)) (vnames p)]
      rw [hx₃ e rfl, List.append_nil]
    have e₂ : vnames q = (vnames q).take (S.entityLen a.1 (vnames q)) := by
      conv_lhs => rw [← List.take_append_drop (S.entityLen a.1 (vnames q)) (vnames q)]
      rw [hx₃' e rfl, List.append_nil]
    rw [← e₁, ← e₂] at hpe
    simp [hpe]

/-- In a free schema and a sound list of value types, `pathEqV` decides path equality
with conversions. -/
theorem pathEqV_iff_of_free (hS : S.WellFormed) (hL : L.Sound) (hfree : S.eqns = [])
    (a : S.VObj L) (l l' : List String) : S.pathEqV L a.1 l l' = true ↔ S.VPathEq L a l l' :=
  ⟨pathEqV_sound hS a, pathEqV_complete hS hL fun a l l' h =>
    (pathEq_iff_of_free hS hfree a l l').mpr h⟩

/-- In an acyclic schema and a sound list of value types, `pathEqV` decides path equality
with conversions. -/
theorem pathEqV_iff_of_acyclic (hS : S.WellFormed) (hL : L.Sound) (hA : S.Acyclic)
    (a : S.VObj L) (l l' : List String) : S.pathEqV L a.1 l l' = true ↔ S.VPathEq L a l l' :=
  ⟨pathEqV_sound hS a, pathEqV_complete hS hL fun a l l' h =>
    (pathEq_iff_of_acyclic hS hA a l l').mpr h⟩

theorem entityLen_of_tgt? {o x : Ob} {l : List String} (h : S.tgt? o l = some x) :
    S.entityLen o l = l.length := by
  have := entityLen_append_tgt? (S := S) [] h
  simpa [entityLen] using this

/-- For a sound list of value types, `S.cat` is faithful in `S.vcat L`: two paths of
`S` that are equal with conversions are equal in `S`. -/
theorem pathEq_of_vPathEq (hS : S.WellFormed) (hL : L.Sound) {a : S.Obj} {l l' : List String}
    {o o' : Ob} (hl : S.tgt? a.1 l = some o) (hl' : S.tgt? a.1 l' = some o')
    (h : S.VPathEq L ⟨a.1, a.2⟩ l l') : S.PathEq a l l' := by
  obtain ⟨b, p, q, rfl, rfl, hpq⟩ := h
  have hs := (splitEq_of_vmor hS hL hpq).1
  rw [entityLen_of_tgt? hl, entityLen_of_tgt? hl', List.take_length, List.take_length] at hs
  exact pathEq_of_rewrites hS hs hl

end Schema

namespace Translation

open Schema

variable {S S' : Schema} {L : TypeList}

/-- Along an inclusion valid with conversions, a path of `S` is a path of `S'`. -/
theorem VValid.tgt?_empty (hT : ({} : Translation).VValid L S S') :
    ∀ {o x : Ob} {l : List String}, S.tgt? o l = some x → S'.tgt? o l = some x
  | _, _, [], h => h
  | o, x, n :: ns, h => by
    cases hs : S.step? o n with
    | none => simp [hs] at h
    | some o₁ =>
      simp only [Schema.tgt?_cons, hs, Option.bind_some] at h
      have h₁ := hT.vtgt?_gen (Schema.vstep?_of_step? (L := L) hs)
      simp only [ob_empty, gen_empty] at h₁
      cases o with
      | value => simp [Schema.step?] at hs
      | entity e =>
        have h₂ : S'.step? (.entity e) n = some o₁ := by
          simpa [Schema.vtgt?, Schema.vstep?] using h₁
        simp only [Schema.tgt?_cons, h₂, Option.bind_some]
        exact VValid.tgt?_empty hT h

/-- For a sound list of value types, an inclusion valid with conversions is valid. -/
theorem VValid.valid_empty (hS : S.WellFormed) (hS' : S'.WellFormed) (hL : L.Sound)
    (hT : ({} : Translation).VValid L S S') : ({} : Translation).Valid S S' where
  entity := hT.entity
  ref := hT.ref
  attr a ha := by
    have h := hT.attr a ha
    simp only [ob_empty, gen_empty] at h ⊢
    simpa [Schema.vtgt?, Schema.vstep?] using h
  eqn q hq := by
    obtain ⟨o, hl, hr⟩ := hS.eqn_parallel q hq
    obtain ⟨hm, hpe⟩ := hT.eqn q hq
    simp only [ent_empty] at hm hpe ⊢
    rw [mapPath_empty hl, mapPath_empty hr] at hpe ⊢
    exact ⟨hm, pathEq_of_vPathEq hS' hL (a := ⟨.entity q.src, hm⟩) (hT.tgt?_empty hl)
      (hT.tgt?_empty hr) hpe⟩

end Translation

